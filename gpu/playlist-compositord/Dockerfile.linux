FROM rust:1.96-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY gpu/playlist-compositord/Cargo.toml gpu/playlist-compositord/Cargo.lock ./
COPY gpu/playlist-compositord/src ./src
COPY internal/video/fonts /internal/video/fonts

RUN cargo test --locked
RUN cargo build --locked --release

ENTRYPOINT ["/src/target/release/playlist-compositord"]
