diff --git a/renderers/source_clock_metrics.c b/renderers/source_clock_metrics.c
new file mode 100644
index 0000000..83cdffe
--- /dev/null
+++ b/renderers/source_clock_metrics.c
@@ -0,0 +1,114 @@
+#include "source_clock_metrics.h"
+
+#include <inttypes.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <time.h>
+#endif
+
+#define SOURCE_CLOCK_RECEIVER_ID_MAX 64u
+
+static const char *failure_reason_name(source_clock_failure_reason_t reason) {
+    switch (reason) {
+    case SOURCE_CLOCK_FAILURE_NONE:
+        return "";
+    case SOURCE_CLOCK_FAILURE_CONNECT:
+        return "connect";
+    case SOURCE_CLOCK_FAILURE_SEND:
+        return "send";
+    case SOURCE_CLOCK_FAILURE_PEER_EOF:
+        return "peer_eof";
+    case SOURCE_CLOCK_FAILURE_QUEUE_DROP:
+        return "queue_drop";
+    default:
+        return NULL;
+    }
+}
+
+bool source_clock_metrics_receiver_id_is_valid(const char *receiver_id) {
+    size_t index;
+    size_t length;
+    if (receiver_id == NULL) return false;
+    length = strlen(receiver_id);
+    if (length == 0 || length > SOURCE_CLOCK_RECEIVER_ID_MAX) return false;
+    for (index = 0; index < length; ++index) {
+        unsigned char value = (unsigned char)receiver_id[index];
+        if (!((value >= 'a' && value <= 'z') ||
+              (value >= 'A' && value <= 'Z') ||
+              (value >= '0' && value <= '9') ||
+              value == '.' || value == '_' || value == '-')) {
+            return false;
+        }
+    }
+    return true;
+}
+
+uint64_t source_clock_metrics_monotonic_time_ns(void) {
+#ifdef _WIN32
+    LARGE_INTEGER frequency;
+    LARGE_INTEGER counter;
+    uint64_t seconds;
+    uint64_t remainder;
+    if (!QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0 ||
+        !QueryPerformanceCounter(&counter) || counter.QuadPart < 0) {
+        return 0;
+    }
+    seconds = (uint64_t)counter.QuadPart / (uint64_t)frequency.QuadPart;
+    remainder = (uint64_t)counter.QuadPart % (uint64_t)frequency.QuadPart;
+    return seconds * 1000000000ULL +
+           (remainder * 1000000000ULL) / (uint64_t)frequency.QuadPart;
+#else
+    struct timespec value;
+    if (clock_gettime(CLOCK_MONOTONIC, &value) != 0) return 0;
+    return (uint64_t)value.tv_sec * 1000000000ULL + (uint64_t)value.tv_nsec;
+#endif
+}
+
+bool source_clock_metrics_write(FILE *stream,
+                                const source_clock_metrics_snapshot_t *snapshot) {
+    const char *failure_reason;
+    char video_age[32];
+    char audio_age[32];
+    char line[1024];
+    int length;
+    if (stream == NULL || snapshot == NULL ||
+        !source_clock_metrics_receiver_id_is_valid(snapshot->receiver_id)) {
+        return false;
+    }
+    failure_reason = failure_reason_name(snapshot->last_failure_reason);
+    if (failure_reason == NULL) return false;
+    if (snapshot->has_video_age) {
+        length = snprintf(video_age, sizeof(video_age), "%" PRIu64,
+                          snapshot->video_age_ms);
+    } else {
+        length = snprintf(video_age, sizeof(video_age), "null");
+    }
+    if (length < 0 || (size_t)length >= sizeof(video_age)) return false;
+    if (snapshot->has_audio_age) {
+        length = snprintf(audio_age, sizeof(audio_age), "%" PRIu64,
+                          snapshot->audio_age_ms);
+    } else {
+        length = snprintf(audio_age, sizeof(audio_age), "null");
+    }
+    if (length < 0 || (size_t)length >= sizeof(audio_age)) return false;
+    length = snprintf(
+        line, sizeof(line),
+        SOURCE_CLOCK_METRICS_PREFIX
+        "{\"receiverId\":\"%s\",\"sequence\":%" PRIu64
+        ",\"videoFrames\":%" PRIu64 ",\"audioFrames\":%" PRIu64
+        ",\"videoAgeMs\":%s,\"audioAgeMs\":%s"
+        ",\"connectedConsumers\":%" PRIu64
+        ",\"sentFrames\":%" PRIu64 ",\"droppedFrames\":%" PRIu64
+        ",\"failureEvents\":%" PRIu64 ",\"lastSocketError\":%d,\"lastFailureReason\":\"%s\"}\n",
+        snapshot->receiver_id, snapshot->sequence, snapshot->video_frames,
+        snapshot->audio_frames, video_age, audio_age,
+        snapshot->connected_consumers, snapshot->sent_frames,
+        snapshot->dropped_frames, snapshot->failure_events, snapshot->last_socket_error,
+        failure_reason);
+    if (length < 0 || (size_t)length >= sizeof(line)) return false;
+    if (fwrite(line, 1, (size_t)length, stream) != (size_t)length) return false;
+    return fflush(stream) == 0;
+}
