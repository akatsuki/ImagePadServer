+#ifndef UXPLAY_SOURCE_CLOCK_METRICS_H
+#define UXPLAY_SOURCE_CLOCK_METRICS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SOURCE_CLOCK_METRICS_PREFIX "IMAGEPAD_METRICS_V1 "
+
+typedef enum source_clock_failure_reason_e {
+    SOURCE_CLOCK_FAILURE_NONE = 0,
+    SOURCE_CLOCK_FAILURE_CONNECT,
+    SOURCE_CLOCK_FAILURE_SEND,
+    SOURCE_CLOCK_FAILURE_PEER_EOF,
+    SOURCE_CLOCK_FAILURE_QUEUE_DROP
+} source_clock_failure_reason_t;
+
+typedef struct source_clock_metrics_snapshot_s {
+    const char *receiver_id;
+    uint64_t sequence;
+    uint64_t video_frames;
+    uint64_t audio_frames;
+    bool has_video_age;
+    uint64_t video_age_ms;
+    bool has_audio_age;
+    uint64_t audio_age_ms;
+    uint64_t connected_consumers;
+    uint64_t sent_frames;
+    uint64_t dropped_frames, failure_events;
+    int last_socket_error;
+    source_clock_failure_reason_t last_failure_reason;
+} source_clock_metrics_snapshot_t;
+
+bool source_clock_metrics_receiver_id_is_valid(const char *receiver_id);
+uint64_t source_clock_metrics_monotonic_time_ns(void);
+bool source_clock_metrics_write(FILE *stream,
+                                const source_clock_metrics_snapshot_t *snapshot);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/renderers/source_clock_metrics_contract_test.c b/renderers/source_clock_metrics_contract_test.c
new file mode 100644
index 0000000..0328bbd
--- /dev/null
+++ b/renderers/source_clock_metrics_contract_test.c
@@ -0,0 +1,100 @@
+#include "source_clock_metrics.h"
+
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static void read_stream(FILE *stream, char *buffer, size_t capacity) {
+    size_t length;
+    assert(fflush(stream) == 0);
+    assert(fseek(stream, 0, SEEK_SET) == 0);
+    length = fread(buffer, 1, capacity - 1, stream);
+    assert(!ferror(stream));
+    buffer[length] = '\0';
+}
+
+static source_clock_metrics_snapshot_t base_snapshot(void) {
+    source_clock_metrics_snapshot_t snapshot = { 0 };
+    snapshot.receiver_id = "receiver-01_A.test";
+    snapshot.sequence = 7;
+    snapshot.video_frames = 11;
+    snapshot.audio_frames = 0;
+    snapshot.connected_consumers = 1;
+    snapshot.sent_frames = 9;
+    snapshot.dropped_frames = 2; snapshot.failure_events = 3;
+    snapshot.last_socket_error = 0;
+    snapshot.last_failure_reason = SOURCE_CLOCK_FAILURE_NONE;
+    return snapshot;
+}
+
+int main(void) {
+    source_clock_metrics_snapshot_t snapshot = base_snapshot();
+    char output[1024];
+    FILE *stream;
+
+    assert(source_clock_metrics_receiver_id_is_valid("a"));
+    assert(source_clock_metrics_receiver_id_is_valid("receiver-01_A.test"));
+    assert(!source_clock_metrics_receiver_id_is_valid(NULL));
+    assert(!source_clock_metrics_receiver_id_is_valid(""));
+    assert(!source_clock_metrics_receiver_id_is_valid("bad\nline"));
+    assert(!source_clock_metrics_receiver_id_is_valid("bad\"quote"));
+    assert(!source_clock_metrics_receiver_id_is_valid(
+        "12345678901234567890123456789012345678901234567890123456789012345"));
+
+    stream = tmpfile();
+    assert(stream != NULL);
+    assert(source_clock_metrics_write(stream, &snapshot));
+    read_stream(stream, output, sizeof(output));
+    assert(strcmp(output,
+        "IMAGEPAD_METRICS_V1 {\"receiverId\":\"receiver-01_A.test\","
+        "\"sequence\":7,\"videoFrames\":11,\"audioFrames\":0,"
+        "\"videoAgeMs\":null,\"audioAgeMs\":null,"
+        "\"connectedConsumers\":1,\"sentFrames\":9,\"droppedFrames\":2,\"failureEvents\":3,"
+        "\"lastSocketError\":0,\"lastFailureReason\":\"\"}\n") == 0);
+    fclose(stream);
+
+    snapshot.sequence = 8;
+    snapshot.audio_frames = 4;
+    snapshot.has_video_age = true;
+    snapshot.video_age_ms = 123;
+    snapshot.has_audio_age = true;
+    snapshot.audio_age_ms = 45;
+    snapshot.last_socket_error = 10054;
+    snapshot.last_failure_reason = SOURCE_CLOCK_FAILURE_SEND;
+    stream = tmpfile();
+    assert(stream != NULL);
+    assert(source_clock_metrics_write(stream, &snapshot));
+    read_stream(stream, output, sizeof(output));
+    assert(strstr(output, "\"videoAgeMs\":123") != NULL);
+    assert(strstr(output, "\"audioAgeMs\":45") != NULL);
+    assert(strstr(output, "\"failureEvents\":3") != NULL); assert(strstr(output, "\"lastSocketError\":10054") != NULL);
+    assert(strstr(output, "\"lastFailureReason\":\"send\"") != NULL);
+    assert(strchr(output, '\n') == output + strlen(output) - 1);
+    assert(strstr(output, "token") == NULL);
+    assert(strstr(output, "payload") == NULL);
+    assert(strstr(output, "endpoint") == NULL);
+    fclose(stream);
+
+    snapshot.receiver_id = "bad\nline";
+    stream = tmpfile();
+    assert(stream != NULL);
+    assert(!source_clock_metrics_write(stream, &snapshot));
+    read_stream(stream, output, sizeof(output));
+    assert(output[0] == '\0');
+    fclose(stream);
+
+    snapshot = base_snapshot();
+    snapshot.last_failure_reason = (source_clock_failure_reason_t)999;
+    stream = tmpfile();
+    assert(stream != NULL);
+    assert(!source_clock_metrics_write(stream, &snapshot));
+    read_stream(stream, output, sizeof(output));
+    assert(output[0] == '\0');
+    fclose(stream);
+
+    puts("source_clock_metrics_contract: PASS");
+    return 0;
+}
