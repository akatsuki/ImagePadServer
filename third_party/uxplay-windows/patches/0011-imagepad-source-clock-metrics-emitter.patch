+bool source_clock_renderer_start_metrics_emitter(source_clock_renderer_t *renderer,
+                                                 FILE *stream) {
+    uint64_t now_ns;
+    if (renderer == NULL || stream == NULL ||
+        !renderer->metrics_emitter_mutex_initialized) return false;
+    pthread_mutex_lock(&renderer->metrics_emitter_mutex);
+    if (renderer->metrics_emitter_thread_started || renderer->metrics_emitter_stopping) {
+        pthread_mutex_unlock(&renderer->metrics_emitter_mutex);
+        return false;
+    }
+#ifdef SOURCE_CLOCK_TEST_HOOKS
+    if (renderer->emitter_thread_create_should_fail) {
+        renderer->metrics_emitter_stopping = true;
+        pthread_mutex_unlock(&renderer->metrics_emitter_mutex);
+        return false;
+    }
+#endif
+#ifdef SOURCE_CLOCK_TEST_HOOKS
+    now_ns = renderer->emitter_start_time_should_fail ? 0 :
+             source_clock_metrics_monotonic_time_ns();
+#else
+    now_ns = source_clock_metrics_monotonic_time_ns();
+#endif
+    if (now_ns == 0) {
+        renderer->metrics_emitter_stopping = true;
+        pthread_mutex_unlock(&renderer->metrics_emitter_mutex);
+        return false;
+    }
+    renderer->metrics_stream = stream;
+    renderer->metrics_emitter_next_emit_ns = now_ns + 1000000000ULL;
