+static void metrics_emitter_wait_tick(source_clock_renderer_t *renderer) {
+    struct timespec deadline;
+    if (timespec_get(&deadline, TIME_UTC) != TIME_UTC) return;
+    deadline.tv_nsec += 100000000L;
+    if (deadline.tv_nsec >= 1000000000L) {
+        deadline.tv_sec++;
+        deadline.tv_nsec -= 1000000000L;
+    }
+    pthread_cond_timedwait(&renderer->metrics_emitter_cond,
+                           &renderer->metrics_emitter_mutex, &deadline);
+}
+
+static void *metrics_emitter_main(void *argument) {
+    source_clock_renderer_t *renderer = (source_clock_renderer_t *)argument;
+    for (;;) {
+        source_clock_metrics_snapshot_t snapshot;
+        FILE *stream;
+        uint64_t now_ns;
+
+        pthread_mutex_lock(&renderer->metrics_emitter_mutex);
+        for (;;) {
+            now_ns = source_clock_metrics_monotonic_time_ns();
+            if (renderer->metrics_emitter_stopping ||
+                now_ns >= renderer->metrics_emitter_next_emit_ns) {
+                break;
+            }
+            metrics_emitter_wait_tick(renderer);
+        }
+        if (renderer->metrics_emitter_stopping) {
+            pthread_mutex_unlock(&renderer->metrics_emitter_mutex);
+            break;
+        }
+        stream = renderer->metrics_stream;
+        renderer->metrics_emitter_next_emit_ns = now_ns + 1000000000ULL;
+        pthread_mutex_unlock(&renderer->metrics_emitter_mutex);
+
+        if (stream != NULL && source_clock_renderer_metrics_snapshot(renderer, now_ns, &snapshot)) {
+            (void)source_clock_metrics_write(stream, &snapshot);
+        }
+    }
+    return NULL;
+}
