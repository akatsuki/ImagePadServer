index 00000000..64dba512
--- /dev/null
+++ b/renderers/source_clock_metrics_emitter_test.c
@@ -0,0 +1,263 @@
+#include "source_clock_renderer.h"
+#include "source_clock_metrics.h"
+
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <assert.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <time.h>
+#include <unistd.h>
+#endif
+
+#ifdef _WIN32
+#define TEST_STRTOK strtok_s
+#else
+#define TEST_STRTOK strtok_r
+#endif
+
+static void sleep_ms(unsigned milliseconds) {
+#ifdef _WIN32
+    Sleep(milliseconds);
+#else
+    usleep(milliseconds * 1000U);
+#endif
+}
+
+static uint64_t monotonic_ms(void) {
+    return source_clock_metrics_monotonic_time_ns() / 1000000ULL;
+}
+
+static long stream_size(FILE *stream) {
+    long position;
+    assert(fflush(stream) == 0);
+    position = ftell(stream);
+    assert(position >= 0);
+    return position;
+}
+
+static size_t read_stream(FILE *stream, char *buffer, size_t capacity) {
+    size_t length;
+    assert(fflush(stream) == 0);
+    assert(fseek(stream, 0, SEEK_SET) == 0);
+    length = fread(buffer, 1, capacity - 1, stream);
+    assert(!ferror(stream));
+    buffer[length] = '\0';
+    return length;
+}
+
+static void assert_json_line(const char *line, uint64_t *sequence) {
+    const char *json;
+    const char *sequence_field;
+    char *end;
+    unsigned braces = 0;
+    unsigned quotes = 0;
+    int escaped = 0;
+    size_t index;
+
+    assert(strncmp(line, SOURCE_CLOCK_METRICS_PREFIX,
+                   strlen(SOURCE_CLOCK_METRICS_PREFIX)) == 0);
+    json = line + strlen(SOURCE_CLOCK_METRICS_PREFIX);
+    assert(json[0] == '{');
+    assert(json[strlen(json) - 2] == '}' && json[strlen(json) - 1] == '\n');
+    for (index = 0; json[index] != '\0'; ++index) {
+        if (escaped) {
+            escaped = 0;
+            continue;
+        }
+        if (json[index] == '\\') {
+            escaped = 1;
+        } else if (json[index] == '"') {
+            quotes++;
+        } else if (json[index] == '{') {
+            braces++;
+        } else if (json[index] == '}') {
+            assert(braces > 0);
+            braces--;
+        }
+    }
+    assert(braces == 0 && (quotes % 2) == 0 && !escaped);
+    assert(strstr(json, "\"receiverId\"") != NULL);
+    assert(strstr(json, "\"sequence\"") != NULL);
+    assert(strstr(json, "\"videoFrames\"") != NULL);
+    assert(strstr(json, "\"audioFrames\"") != NULL);
+    assert(strstr(json, "\"videoAgeMs\"") != NULL);
+    assert(strstr(json, "\"audioAgeMs\"") != NULL);
+    assert(strstr(json, "\"connectedConsumers\"") != NULL);
+    assert(strstr(json, "\"sentFrames\"") != NULL);
+    assert(strstr(json, "\"droppedFrames\"") != NULL); assert(strstr(json, "\"failureEvents\"") != NULL);
+    assert(strstr(json, "\"lastSocketError\"") != NULL);
+    assert(strstr(json, "\"lastFailureReason\"") != NULL);
+    assert(strstr(json, "token") == NULL);
+    assert(strstr(json, "payload") == NULL);
+    assert(strstr(json, "endpoint") == NULL);
+
+    sequence_field = strstr(json, "\"sequence\":");
+    assert(sequence_field != NULL);
+    *sequence = strtoull(sequence_field + strlen("\"sequence\":"), &end, 10);
+    assert(end != sequence_field + strlen("\"sequence\":"));
+}
+
+static unsigned inspect_stream(FILE *stream, int require_video_age, int require_audio_null,
+                               uint64_t *first_sequence) {
+    char output[8192];
+    char *line;
+    char *save = NULL;
+    uint64_t previous_sequence = 0;
+    unsigned lines = 0;
+    size_t length = read_stream(stream, output, sizeof(output));
+    assert(length < sizeof(output) - 1);
+    for (line = TEST_STRTOK(output, "\n", &save); line != NULL;
+         line = TEST_STRTOK(NULL, "\n", &save)) {
+        char line_with_newline[2048];
+        uint64_t sequence;
+        assert(strlen(line) + 2 < sizeof(line_with_newline));
+        snprintf(line_with_newline, sizeof(line_with_newline), "%s\n", line);
+        assert_json_line(line_with_newline, &sequence);
+        if (lines != 0) assert(sequence > previous_sequence);
+        previous_sequence = sequence;
+        if (lines == 0 && first_sequence != NULL) *first_sequence = sequence;
+        if (require_video_age) assert(strstr(line, "\"videoAgeMs\":null") == NULL);
+        if (require_audio_null) assert(strstr(line, "\"audioAgeMs\":null") != NULL);
+        lines++;
+    }
+    assert(lines > 0 && lines <= 3);
+    return lines;
+}
+
+static source_clock_renderer_t *create_test_renderer(void) {
+    return source_clock_renderer_create("127.0.0.1:1", "127.0.0.1:1",
+                                        "00112233445566778899aabbccddeeff",
+                                        "emitter-test");
+}
+
+static void test_explicit_start_and_no_input(void) {
+    source_clock_renderer_t *renderer = create_test_renderer();
+    FILE *stream = tmpfile();
+    uint64_t started_at;
+    uint64_t first_sequence = 0;
+    long before_start;
+    uint64_t first_output_at = 0;
+
+    assert(renderer != NULL && stream != NULL);
+    sleep_ms(1100);
+    before_start = stream_size(stream);
+    assert(before_start == 0);
+    started_at = monotonic_ms();
+    assert(source_clock_renderer_start_metrics_emitter(renderer, stream));
+    while (stream_size(stream) == 0 && monotonic_ms() - started_at < 1700) {
+        sleep_ms(50);
+    }
+    first_output_at = monotonic_ms();
+    assert(first_output_at - started_at >= 900);
+    assert(stream_size(stream) > 0);
+    while (monotonic_ms() - started_at < 2300) sleep_ms(50);
+    assert(inspect_stream(stream, 0, 1, &first_sequence) >= 1);
+    {
+        char output[8192];
+        unsigned lines = 0;
+        char *line;
+        char *save = NULL;
+        read_stream(stream, output, sizeof(output));
+        for (line = TEST_STRTOK(output, "\n", &save); line != NULL;
+             line = TEST_STRTOK(NULL, "\n", &save)) {
+            lines++;
+        }
+        assert(lines >= 1 && lines <= 2);
+    }
+    assert(first_sequence > 0);
+    source_clock_renderer_destroy(renderer);
+    fclose(stream);
+}
+
+static void test_video_only_keeps_audio_age_null(void) {
+    static const unsigned char video[] = { 0, 0, 0, 1, 0x65, 0x88 };
+    source_clock_renderer_t *renderer = create_test_renderer();
+    FILE *stream = tmpfile();
+
+    assert(renderer != NULL && stream != NULL);
+    assert(source_clock_renderer_start_metrics_emitter(renderer, stream));
+    assert(source_clock_renderer_push_video(renderer, video, sizeof(video), 1, 0));
+    sleep_ms(2200);
+    assert(inspect_stream(stream, 1, 1, NULL) >= 1);
+    source_clock_renderer_destroy(renderer);
+    fclose(stream);
+}
+
+static void test_emitter_start_failure_is_fail_closed(void) {
+    source_clock_renderer_t *renderer = create_test_renderer();
+    FILE *stream = tmpfile();
+
+    assert(renderer != NULL && stream != NULL);
+#ifdef SOURCE_CLOCK_TEST_HOOKS
+    source_clock_renderer_set_emitter_thread_create_failure(renderer, true);
+    assert(!source_clock_renderer_start_metrics_emitter(renderer, stream));
+#endif
+    source_clock_renderer_destroy(renderer);
+    fclose(stream);
+}
+
+static void test_zero_start_time_is_fail_closed(void) {
+    source_clock_renderer_t *renderer = create_test_renderer();
+    FILE *stream = tmpfile();
+
+    assert(renderer != NULL && stream != NULL);
+#ifdef SOURCE_CLOCK_TEST_HOOKS
+    source_clock_renderer_set_emitter_start_time_zero(renderer, true);
+    assert(!source_clock_renderer_start_metrics_emitter(renderer, stream));
+#endif
+    source_clock_renderer_destroy(renderer);
+    fclose(stream);
+}
+
+static void test_destroy_wakes_emitter_for_join(void) {
+    source_clock_renderer_t *renderer = create_test_renderer();
+    FILE *stream = tmpfile();
+    uint64_t started_at;
+
+    assert(renderer != NULL && stream != NULL);
+    assert(source_clock_renderer_start_metrics_emitter(renderer, stream));
+    started_at = monotonic_ms();
+    source_clock_renderer_destroy(renderer);
+    assert(monotonic_ms() - started_at < 500);
+    fclose(stream);
+}
+
+static void test_destroy_after_queued_video_frames_repeatedly(void) {
+    static const unsigned char video[] = { 0, 0, 0, 1, 0x65, 0x88 };
+    unsigned iteration;
+    for (iteration = 0; iteration < 20; ++iteration) {
+        source_clock_renderer_t *renderer = create_test_renderer();
+        FILE *stream = tmpfile();
+        uint64_t started_at;
+        unsigned frame;
+
+        assert(renderer != NULL && stream != NULL);
+        assert(source_clock_renderer_start_metrics_emitter(renderer, stream));
+        for (frame = 0; frame < 8; ++frame) {
+            assert(source_clock_renderer_push_video(renderer, video, sizeof(video), 1, 0));
+        }
+        started_at = monotonic_ms();
+        source_clock_renderer_destroy(renderer);
+        assert(monotonic_ms() - started_at < 500);
+        fclose(stream);
+    }
+}
+
+int main(void) {
+    test_explicit_start_and_no_input();
+    test_video_only_keeps_audio_age_null();
+    test_emitter_start_failure_is_fail_closed();
+    test_zero_start_time_is_fail_closed();
+    test_destroy_wakes_emitter_for_join();
+    test_destroy_after_queued_video_frames_repeatedly();
+    puts("source_clock_metrics_emitter: PASS");
+    return 0;
+}
