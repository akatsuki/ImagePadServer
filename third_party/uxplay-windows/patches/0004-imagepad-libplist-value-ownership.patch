new file mode 100644
index 00000000..b7c89411
--- /dev/null
+++ b/lib/plist_ownership.h
@@ -0,0 +1,15 @@
+#ifndef IMAGEPAD_PLIST_OWNERSHIP_H
+#define IMAGEPAD_PLIST_OWNERSHIP_H
+
+#include <stdlib.h>
+#include <plist/plist.h>
+
+static inline void imagepad_plist_value_free(void *value) {
+#ifdef PLIST_230
+    plist_mem_free(value);
+#else
+    free(value);
+#endif
+}
+
+#endif
