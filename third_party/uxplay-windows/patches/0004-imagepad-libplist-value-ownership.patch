diff --git a/lib/tests/plist_ownership_test.c b/lib/tests/plist_ownership_test.c
new file mode 100644
index 00000000..5ddb9da6
--- /dev/null
+++ b/lib/tests/plist_ownership_test.c
@@ -0,0 +1,48 @@
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <plist/plist.h>
+
+#include "../plist_ownership.h"
+
+static int check_data_value(size_t length) {
+    char payload[72];
+    for (size_t i = 0; i < sizeof(payload); i++) payload[i] = (char)i;
+    plist_t data_node = plist_new_data(payload, length);
+    char *data_value = NULL;
+    uint64_t data_length = 0;
+    if (data_node == NULL) return 1;
+    plist_get_data_val(data_node, &data_value, &data_length);
+    if (data_value == NULL || data_length != length || memcmp(data_value, payload, length) != 0) {
+        return 2;
+    }
+    imagepad_plist_value_free(data_value);
+    plist_free(data_node);
+    return 0;
+}
+
+static int check_string_value(void) {
+    static const char payload[] = "imagepad-plist-ownership";
+    plist_t string_node = plist_new_string(payload);
+    char *string_value = NULL;
+    if (string_node == NULL) return 3;
+    plist_get_string_val(string_node, &string_value);
+    if (string_value == NULL || strcmp(string_value, payload) != 0) return 4;
+    imagepad_plist_value_free(string_value);
+    plist_free(string_node);
+    return 0;
+}
+
+int main(void) {
+    static const size_t lengths[] = {16, 32, 64, 72};
+    for (int iteration = 0; iteration < 1000; iteration++) {
+        for (size_t i = 0; i < sizeof(lengths) / sizeof(lengths[0]); i++) {
+            int result = check_data_value(lengths[i]);
+            if (result != 0) return result;
+        }
+        int result = check_string_value();
+        if (result != 0) return result;
+    }
+    return 0;
+}
