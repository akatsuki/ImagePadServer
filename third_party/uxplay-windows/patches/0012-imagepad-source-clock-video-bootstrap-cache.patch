diff --git a/renderers/source_clock_video_bootstrap.c b/renderers/source_clock_video_bootstrap.c
new file mode 100644
index 00000000..82d68d50
--- /dev/null
+++ b/renderers/source_clock_video_bootstrap.c
@@ -0,0 +1,530 @@
+#include "source_clock_video_bootstrap.h"
+
+#include <limits.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define NAL_SPS 7U
+#define NAL_PPS 8U
+
+typedef struct parameter_set_s {
+    unsigned char nal_type;
+    uint32_t id;
+    uint32_t referenced_sps_id;
+    unsigned char *data;
+    size_t size;
+} parameter_set_t;
+
+typedef struct parsed_set_s {
+    unsigned char nal_type;
+    uint32_t id;
+    uint32_t referenced_sps_id;
+    const unsigned char *data;
+    size_t size;
+} parsed_set_t;
+
+struct source_clock_video_bootstrap_s {
+    pthread_mutex_t mutex;
+    bool active;
+    uint64_t session_epoch;
+    source_clock_video_bootstrap_codec_t codec;
+    uint64_t codec_epoch;
+    parameter_set_t entries[SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_PARAMETER_SETS];
+    size_t entry_count;
+    size_t total_bytes;
+#ifdef SOURCE_CLOCK_TEST_HOOKS
+    int64_t fail_alloc_after;
+    uint64_t allocation_count;
+#endif
+};
+
+typedef struct bit_reader_s {
+    const unsigned char *data;
+    size_t bit_count;
+    size_t bit_position;
+} bit_reader_t;
+
+static void free_entries(parameter_set_t *entries, size_t count) {
+    size_t index;
+    for (index = 0; index < count; ++index) {
+        free(entries[index].data);
+        memset(&entries[index], 0, sizeof(entries[index]));
+    }
+}
+
+static void clear_locked(source_clock_video_bootstrap_t *cache) {
+    free_entries(cache->entries, cache->entry_count);
+    cache->entry_count = 0;
+    cache->total_bytes = 0;
+    cache->codec_epoch = 0;
+}
+
+static bool find_start_code(const unsigned char *data, size_t size, size_t from,
+                            size_t *position, size_t *length) {
+    size_t index;
+    if (data == NULL || position == NULL || length == NULL) return false;
+    for (index = from; index + 3U <= size; ++index) {
+        if (index + 4U <= size && data[index] == 0 && data[index + 1U] == 0 &&
+            data[index + 2U] == 0 && data[index + 3U] == 1) {
+            *position = index;
+            *length = 4U;
+            return true;
+        }
+        if (data[index] == 0 && data[index + 1U] == 0 && data[index + 2U] == 1) {
+            *position = index;
+            *length = 3U;
+            return true;
+        }
+    }
+    return false;
+}
+
+static void *cache_alloc(source_clock_video_bootstrap_t *cache, size_t size) {
+#ifdef SOURCE_CLOCK_TEST_HOOKS
+    if (cache->fail_alloc_after >= 0 &&
+        cache->allocation_count++ >= (uint64_t)cache->fail_alloc_after) return NULL;
+#else
+    (void)cache;
+#endif
+    return malloc(size);
+}
+
+static source_clock_video_bootstrap_result_t ebsp_to_rbsp(
+                         source_clock_video_bootstrap_t *cache,
+                         const unsigned char *ebsp, size_t ebsp_size,
+                         unsigned char **rbsp, size_t *rbsp_size) {
+    unsigned char *output;
+    size_t input_index;
+    size_t output_index = 0;
+    unsigned zero_count = 0;
+    if (cache == NULL || ebsp == NULL || ebsp_size == 0 || rbsp == NULL || rbsp_size == NULL)
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    output = (unsigned char *)cache_alloc(cache, ebsp_size);
+    if (output == NULL) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_NOMEM;
+    for (input_index = 0; input_index < ebsp_size; ++input_index) {
+        unsigned char value = ebsp[input_index];
+        if (zero_count >= 2U && value == 3U) {
+            if (input_index + 1U >= ebsp_size || ebsp[input_index + 1U] > 3U) {
+                free(output);
+                return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+            }
+            zero_count = 0;
+            continue;
+        }
+        if (zero_count >= 2U && value <= 2U) {
+            free(output);
+            return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+        }
+        output[output_index++] = value;
+        if (value == 0) zero_count++;
+        else zero_count = 0;
+    }
+    *rbsp = output;
+    *rbsp_size = output_index;
+    return SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNCHANGED;
+}
+
+static bool read_bit(bit_reader_t *reader, unsigned *value) {
+    size_t byte_index;
+    unsigned shift;
+    if (reader == NULL || value == NULL || reader->bit_position >= reader->bit_count) return false;
+    byte_index = reader->bit_position / 8U;
+    shift = 7U - (unsigned)(reader->bit_position % 8U);
+    *value = (reader->data[byte_index] >> shift) & 1U;
+    reader->bit_position++;
+    return true;
+}
+
+static bool skip_bits(bit_reader_t *reader, size_t count) {
+    if (reader == NULL || count > reader->bit_count - reader->bit_position) return false;
+    reader->bit_position += count;
+    return true;
+}
+
+static bool read_ue(bit_reader_t *reader, uint32_t *value) {
+    unsigned bit;
+    unsigned leading_zeroes = 0;
+    uint64_t suffix = 0;
+    unsigned index;
+    if (reader == NULL || value == NULL) return false;
+    while (true) {
+        if (!read_bit(reader, &bit)) return false;
+        if (bit != 0) break;
+        if (++leading_zeroes > 31U) return false;
+    }
+    for (index = 0; index < leading_zeroes; ++index) {
+        if (!read_bit(reader, &bit)) return false;
+        suffix = (suffix << 1U) | bit;
+    }
+    suffix += ((uint64_t)1U << leading_zeroes) - 1U;
+    if (suffix > UINT32_MAX) return false;
+    *value = (uint32_t)suffix;
+    return true;
+}
+
+static source_clock_video_bootstrap_result_t parse_ids(
+                      source_clock_video_bootstrap_t *cache,
+                      unsigned char nal_type, const unsigned char *nal, size_t size,
+                      uint32_t *id, uint32_t *referenced_sps_id) {
+    unsigned char *rbsp = NULL;
+    size_t rbsp_size = 0;
+    bit_reader_t reader;
+    uint32_t first = 0;
+    uint32_t second = 0;
+    bool ok = false;
+    source_clock_video_bootstrap_result_t result;
+    if (nal == NULL || size < 2U || id == NULL || referenced_sps_id == NULL ||
+        (nal[0] & 0x80U) != 0 || (nal[0] & 0x1fU) != nal_type)
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    result = ebsp_to_rbsp(cache, nal + 1U, size - 1U, &rbsp, &rbsp_size);
+    if (result < 0) return result;
+    reader.data = rbsp;
+    reader.bit_count = rbsp_size * 8U;
+    reader.bit_position = 0;
+    if (nal_type == NAL_SPS) {
+        ok = skip_bits(&reader, 24U) && read_ue(&reader, &first) && first <= 31U;
+        if (ok) second = first;
+    } else if (nal_type == NAL_PPS) {
+        ok = read_ue(&reader, &first) && read_ue(&reader, &second) &&
+             first <= 255U && second <= 31U;
+    }
+    free(rbsp);
+    if (!ok) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    *id = first;
+    *referenced_sps_id = second;
+    return SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNCHANGED;
+}
+
+static source_clock_video_bootstrap_result_t parse_annexb(
+    source_clock_video_bootstrap_t *cache,
+    const unsigned char *data, size_t size, parsed_set_t *sets,
+    size_t *set_count) {
+    size_t position;
+    size_t start_length;
+    size_t next_position;
+    size_t next_length;
+    size_t nal_count = 0;
+    size_t count = 0;
+    size_t index;
+    if (cache == NULL || data == NULL || size == 0 || sets == NULL || set_count == NULL)
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    if (size > SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_INPUT_SIZE)
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_LIMIT;
+    if (!find_start_code(data, size, 0, &position, &start_length)) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    for (index = 0; index < position; ++index) if (data[index] != 0) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    while (true) {
+        size_t nal_start = position + start_length;
+        size_t nal_end;
+        bool has_next = find_start_code(data, size, nal_start, &next_position, &next_length);
+        nal_end = has_next ? next_position : size;
+        while (nal_end > nal_start && data[nal_end - 1U] == 0) nal_end--;
+        if (++nal_count > SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_NALS) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_LIMIT;
+        if (nal_end <= nal_start) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+        {
+            unsigned char nal_type = data[nal_start] & 0x1fU;
+            if (nal_type == NAL_SPS || nal_type == NAL_PPS) {
+                parsed_set_t *parsed;
+                if (nal_end - nal_start > SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_NAL_SIZE) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_LIMIT;
+                parsed = &sets[count++];
+                parsed->nal_type = nal_type;
+                parsed->data = data + nal_start;
+                parsed->size = nal_end - nal_start;
+                source_clock_video_bootstrap_result_t parse_result =
+                    parse_ids(cache, nal_type, parsed->data, parsed->size,
+                              &parsed->id, &parsed->referenced_sps_id);
+                if (parse_result < 0) return parse_result;
+            }
+        }
+        if (!has_next) break;
+        position = next_position;
+        start_length = next_length;
+    }
+    *set_count = count;
+    return SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNCHANGED;
+}
+
+static source_clock_video_bootstrap_result_t clone_entries(
+    source_clock_video_bootstrap_t *cache, parameter_set_t *entries) {
+    size_t index;
+    memset(entries, 0, sizeof(parameter_set_t) * SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_PARAMETER_SETS);
+    for (index = 0; index < cache->entry_count; ++index) {
+        entries[index] = cache->entries[index];
+        entries[index].data = (unsigned char *)cache_alloc(cache, cache->entries[index].size);
+        if (entries[index].data == NULL) {
+            free_entries(entries, index);
+            return SOURCE_CLOCK_VIDEO_BOOTSTRAP_NOMEM;
+        }
+        memcpy(entries[index].data, cache->entries[index].data, cache->entries[index].size);
+    }
+    return SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNCHANGED;
+}
+
+static size_t find_entry(parameter_set_t *entries, size_t count,
+                         unsigned char nal_type, uint32_t id) {
+    size_t index;
+    for (index = 0; index < count; ++index) {
+        if (entries[index].nal_type == nal_type && entries[index].id == id) return index;
+    }
+    return SIZE_MAX;
+}
+
+source_clock_video_bootstrap_t *source_clock_video_bootstrap_create(void) {
+    source_clock_video_bootstrap_t *cache =
+        (source_clock_video_bootstrap_t *)calloc(1U, sizeof(*cache));
+    if (cache == NULL) return NULL;
+#ifdef SOURCE_CLOCK_TEST_HOOKS
+    cache->fail_alloc_after = -1;
+#endif
+    if (pthread_mutex_init(&cache->mutex, NULL) != 0) {
+        free(cache);
+        return NULL;
+    }
+    return cache;
+}
+
+void source_clock_video_bootstrap_destroy(source_clock_video_bootstrap_t *cache) {
+    if (cache == NULL) return;
+    pthread_mutex_lock(&cache->mutex);
+    clear_locked(cache);
+    pthread_mutex_unlock(&cache->mutex);
+    pthread_mutex_destroy(&cache->mutex);
+    free(cache);
+}
+
+source_clock_video_bootstrap_result_t source_clock_video_bootstrap_session_start_for_codec(
+    source_clock_video_bootstrap_t *cache, uint64_t session_epoch,
+    source_clock_video_bootstrap_codec_t codec) {
+    if (cache == NULL || session_epoch == 0) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    if (codec != SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNSUPPORTED;
+    pthread_mutex_lock(&cache->mutex);
+    if (session_epoch <= cache->session_epoch) {
+        pthread_mutex_unlock(&cache->mutex);
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_STALE_SESSION;
+    }
+    clear_locked(cache);
+    cache->active = true;
+    cache->session_epoch = session_epoch;
+    cache->codec = codec;
+    pthread_mutex_unlock(&cache->mutex);
+    return SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED;
+}
+
+source_clock_video_bootstrap_result_t source_clock_video_bootstrap_session_end_for_epoch(
+    source_clock_video_bootstrap_t *cache, uint64_t expected_session_epoch) {
+    if (cache == NULL) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    pthread_mutex_lock(&cache->mutex);
+    if (!cache->active || cache->session_epoch != expected_session_epoch) {
+        pthread_mutex_unlock(&cache->mutex);
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_STALE_SESSION;
+    }
+    clear_locked(cache);
+    cache->active = false;
+    pthread_mutex_unlock(&cache->mutex);
+    return SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED;
+}
+
+source_clock_video_bootstrap_result_t source_clock_video_bootstrap_push_annexb_for_session(
+    source_clock_video_bootstrap_t *cache, uint64_t expected_session_epoch,
+    source_clock_video_bootstrap_codec_t codec,
+    const unsigned char *data, size_t size) {
+    parsed_set_t parsed[SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_NALS];
+    parameter_set_t candidate[SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_PARAMETER_SETS];
+    size_t parsed_count = 0;
+    size_t candidate_count;
+    size_t candidate_bytes;
+    size_t index;
+    size_t unique_count = 0;
+    bool changed = false;
+    source_clock_video_bootstrap_result_t result;
+    if (cache == NULL) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    if (codec != SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNSUPPORTED;
+    pthread_mutex_lock(&cache->mutex);
+    if (!cache->active || cache->session_epoch != expected_session_epoch || cache->codec != codec) {
+        pthread_mutex_unlock(&cache->mutex);
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_STALE_SESSION;
+    }
+    result = parse_annexb(cache, data, size, parsed, &parsed_count);
+    if (result < 0) {
+        pthread_mutex_unlock(&cache->mutex);
+        return result;
+    }
+    for (index = 0; index < parsed_count; ++index) {
+        size_t existing;
+        for (existing = 0; existing < unique_count; ++existing) {
+            if (parsed[existing].nal_type == parsed[index].nal_type &&
+                parsed[existing].id == parsed[index].id) break;
+        }
+        if (existing < unique_count) parsed[existing] = parsed[index];
+        else parsed[unique_count++] = parsed[index];
+    }
+    parsed_count = unique_count;
+    if (parsed_count == 0) {
+        pthread_mutex_unlock(&cache->mutex);
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNCHANGED;
+    }
+    result = clone_entries(cache, candidate);
+    if (result < 0) {
+        pthread_mutex_unlock(&cache->mutex);
+        return result;
+    }
+    candidate_count = cache->entry_count;
+    candidate_bytes = cache->total_bytes;
+    for (index = 0; index < parsed_count; ++index) {
+        size_t found = find_entry(candidate, candidate_count, parsed[index].nal_type, parsed[index].id);
+        unsigned char *copy;
+        if (found != SIZE_MAX && candidate[found].size == parsed[index].size &&
+            candidate[found].referenced_sps_id == parsed[index].referenced_sps_id &&
+            memcmp(candidate[found].data, parsed[index].data, parsed[index].size) == 0) continue;
+        if (found == SIZE_MAX) {
+            if (candidate_count >= SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_PARAMETER_SETS) {
+                free_entries(candidate, candidate_count);
+                pthread_mutex_unlock(&cache->mutex);
+                return SOURCE_CLOCK_VIDEO_BOOTSTRAP_LIMIT;
+            }
+            found = candidate_count++;
+            memset(&candidate[found], 0, sizeof(candidate[found]));
+        } else {
+            candidate_bytes -= candidate[found].size;
+        }
+        if (parsed[index].size > SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_TOTAL_SIZE - candidate_bytes) {
+            free_entries(candidate, candidate_count);
+            pthread_mutex_unlock(&cache->mutex);
+            return SOURCE_CLOCK_VIDEO_BOOTSTRAP_LIMIT;
+        }
+        copy = (unsigned char *)cache_alloc(cache, parsed[index].size);
+        if (copy == NULL) {
+            free_entries(candidate, candidate_count);
+            pthread_mutex_unlock(&cache->mutex);
+            return SOURCE_CLOCK_VIDEO_BOOTSTRAP_NOMEM;
+        }
+        memcpy(copy, parsed[index].data, parsed[index].size);
+        free(candidate[found].data);
+        candidate[found].nal_type = parsed[index].nal_type;
+        candidate[found].id = parsed[index].id;
+        candidate[found].referenced_sps_id = parsed[index].referenced_sps_id;
+        candidate[found].data = copy;
+        candidate[found].size = parsed[index].size;
+        candidate_bytes += parsed[index].size;
+        changed = true;
+    }
+    if (!changed) {
+        free_entries(candidate, candidate_count);
+        pthread_mutex_unlock(&cache->mutex);
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNCHANGED;
+    }
+    if (cache->codec_epoch == UINT64_MAX) {
+        free_entries(candidate, candidate_count);
+        pthread_mutex_unlock(&cache->mutex);
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_LIMIT;
+    }
+    free_entries(cache->entries, cache->entry_count);
+    memcpy(cache->entries, candidate, sizeof(candidate));
+    cache->entry_count = candidate_count;
+    cache->total_bytes = candidate_bytes;
+    cache->codec_epoch++;
+    pthread_mutex_unlock(&cache->mutex);
+    return SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED;
+}
+
+source_clock_video_bootstrap_result_t source_clock_video_bootstrap_snapshot_copy_for_pps(
+    source_clock_video_bootstrap_t *cache, uint64_t expected_session_epoch,
+    source_clock_video_bootstrap_codec_t codec, uint32_t pps_id,
+    source_clock_video_bootstrap_snapshot_t *snapshot) {
+    size_t pps_index;
+    size_t sps_index;
+    if (cache == NULL || snapshot == NULL) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    if (snapshot->sps != NULL || snapshot->pps != NULL || snapshot->sps_size != 0 ||
+        snapshot->pps_size != 0 || snapshot->session_epoch != 0 ||
+        snapshot->codec_epoch != 0 || snapshot->sps_id != 0 || snapshot->pps_id != 0)
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID;
+    memset(snapshot, 0, sizeof(*snapshot));
+    if (codec != SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264) return SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNSUPPORTED;
+    pthread_mutex_lock(&cache->mutex);
+    if (!cache->active || cache->session_epoch != expected_session_epoch || cache->codec != codec) {
+        pthread_mutex_unlock(&cache->mutex);
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_STALE_SESSION;
+    }
+    pps_index = find_entry(cache->entries, cache->entry_count, NAL_PPS, pps_id);
+    if (pps_index == SIZE_MAX) {
+        pthread_mutex_unlock(&cache->mutex);
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_NOT_READY;
+    }
+    sps_index = find_entry(cache->entries, cache->entry_count, NAL_SPS,
+                           cache->entries[pps_index].referenced_sps_id);
+    if (sps_index == SIZE_MAX) {
+        pthread_mutex_unlock(&cache->mutex);
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_NOT_READY;
+    }
+    snapshot->sps = (unsigned char *)cache_alloc(cache, cache->entries[sps_index].size);
+    snapshot->pps = (unsigned char *)cache_alloc(cache, cache->entries[pps_index].size);
+    if (snapshot->sps == NULL || snapshot->pps == NULL) {
+        source_clock_video_bootstrap_snapshot_free(snapshot);
+        pthread_mutex_unlock(&cache->mutex);
+        return SOURCE_CLOCK_VIDEO_BOOTSTRAP_NOMEM;
+    }
+    memcpy(snapshot->sps, cache->entries[sps_index].data, cache->entries[sps_index].size);
+    memcpy(snapshot->pps, cache->entries[pps_index].data, cache->entries[pps_index].size);
+    snapshot->session_epoch = cache->session_epoch;
+    snapshot->codec_epoch = cache->codec_epoch;
+    snapshot->sps_id = cache->entries[sps_index].id;
+    snapshot->pps_id = cache->entries[pps_index].id;
+    snapshot->sps_size = cache->entries[sps_index].size;
+    snapshot->pps_size = cache->entries[pps_index].size;
+    pthread_mutex_unlock(&cache->mutex);
+    return SOURCE_CLOCK_VIDEO_BOOTSTRAP_READY;
+}
+
+void source_clock_video_bootstrap_snapshot_free(source_clock_video_bootstrap_snapshot_t *snapshot) {
+    if (snapshot == NULL) return;
+    free(snapshot->sps);
+    free(snapshot->pps);
+    memset(snapshot, 0, sizeof(*snapshot));
+}
+
+size_t source_clock_video_bootstrap_entry_count(source_clock_video_bootstrap_t *cache) {
+    size_t value = 0;
+    if (cache == NULL) return 0;
+    pthread_mutex_lock(&cache->mutex);
+    value = cache->entry_count;
+    pthread_mutex_unlock(&cache->mutex);
+    return value;
+}
+
+size_t source_clock_video_bootstrap_total_bytes(source_clock_video_bootstrap_t *cache) {
+    size_t value = 0;
+    if (cache == NULL) return 0;
+    pthread_mutex_lock(&cache->mutex);
+    value = cache->total_bytes;
+    pthread_mutex_unlock(&cache->mutex);
+    return value;
+}
+
+uint64_t source_clock_video_bootstrap_codec_epoch(source_clock_video_bootstrap_t *cache) {
+    uint64_t value = 0;
+    if (cache == NULL) return 0;
+    pthread_mutex_lock(&cache->mutex);
+    value = cache->codec_epoch;
+    pthread_mutex_unlock(&cache->mutex);
+    return value;
+}
+
+#ifdef SOURCE_CLOCK_TEST_HOOKS
+void source_clock_video_bootstrap_test_fail_alloc_after(
+    source_clock_video_bootstrap_t *cache, int64_t successful_allocations) {
+    if (cache == NULL) return;
+    pthread_mutex_lock(&cache->mutex);
+    cache->fail_alloc_after = successful_allocations;
+    cache->allocation_count = 0;
+    pthread_mutex_unlock(&cache->mutex);
+}
+
+void source_clock_video_bootstrap_test_set_codec_epoch(
+    source_clock_video_bootstrap_t *cache, uint64_t codec_epoch) {
+    if (cache == NULL) return;
+    pthread_mutex_lock(&cache->mutex);
+    cache->codec_epoch = codec_epoch;
+    pthread_mutex_unlock(&cache->mutex);
+}
+#endif
