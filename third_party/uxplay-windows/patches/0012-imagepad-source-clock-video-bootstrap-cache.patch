+++ b/renderers/source_clock_video_bootstrap.h
@@ -0,0 +1,91 @@
+#ifndef SOURCE_CLOCK_VIDEO_BOOTSTRAP_H
+#define SOURCE_CLOCK_VIDEO_BOOTSTRAP_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_PARAMETER_SETS 32U
+#define SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_NAL_SIZE (128U * 1024U)
+#define SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_TOTAL_SIZE (256U * 1024U)
+#define SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_NALS 64U
+#define SOURCE_CLOCK_VIDEO_BOOTSTRAP_MAX_INPUT_SIZE (64U * 1024U * 1024U)
+
+typedef enum source_clock_video_bootstrap_codec_e {
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264 = 1,
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_HEVC = 2
+} source_clock_video_bootstrap_codec_t;
+
+typedef enum source_clock_video_bootstrap_result_e {
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNCHANGED = 0,
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED = 1,
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_READY = 2,
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_NOT_READY = -1,
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_INVALID = -2,
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_LIMIT = -3,
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_NOMEM = -4,
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_STALE_SESSION = -5,
+    SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNSUPPORTED = -6
+} source_clock_video_bootstrap_result_t;
+
+typedef struct source_clock_video_bootstrap_s source_clock_video_bootstrap_t;
+
+typedef struct source_clock_video_bootstrap_snapshot_s {
+    uint64_t session_epoch;
+    uint64_t codec_epoch;
+    uint32_t sps_id;
+    uint32_t pps_id;
+    unsigned char *sps;
+    size_t sps_size;
+    unsigned char *pps;
+    size_t pps_size;
+} source_clock_video_bootstrap_snapshot_t;
+
+source_clock_video_bootstrap_t *source_clock_video_bootstrap_create(void);
+void source_clock_video_bootstrap_destroy(source_clock_video_bootstrap_t *cache);
+source_clock_video_bootstrap_result_t source_clock_video_bootstrap_session_start_for_codec(
+    source_clock_video_bootstrap_t *cache, uint64_t session_epoch,
+    source_clock_video_bootstrap_codec_t codec);
+source_clock_video_bootstrap_result_t source_clock_video_bootstrap_session_end_for_epoch(
+    source_clock_video_bootstrap_t *cache, uint64_t expected_session_epoch);
+source_clock_video_bootstrap_result_t source_clock_video_bootstrap_push_annexb_for_session(
+    source_clock_video_bootstrap_t *cache, uint64_t expected_session_epoch,
+    source_clock_video_bootstrap_codec_t codec,
+    const unsigned char *data, size_t size);
+source_clock_video_bootstrap_result_t source_clock_video_bootstrap_snapshot_copy_for_pps(
+    source_clock_video_bootstrap_t *cache, uint64_t expected_session_epoch,
+    source_clock_video_bootstrap_codec_t codec, uint32_t pps_id,
+    source_clock_video_bootstrap_snapshot_t *snapshot);
+/*
+ * The parser validates Annex-B boundaries, H.264 NAL headers, EBSP escaping,
+ * parameter-set IDs and PPS-to-SPS references. It does not validate the full
+ * SPS/PPS syntax beyond the fields required for bootstrap selection.
+ *
+ * snapshot must be zero-initialized. On READY it owns independent SPS/PPS
+ * copies and must be released with snapshot_free before reuse. Cache APIs may
+ * run concurrently; cache destruction requires external lifetime exclusion.
+ */
+void source_clock_video_bootstrap_snapshot_free(
+    source_clock_video_bootstrap_snapshot_t *snapshot);
+size_t source_clock_video_bootstrap_entry_count(
+    source_clock_video_bootstrap_t *cache);
+size_t source_clock_video_bootstrap_total_bytes(
+    source_clock_video_bootstrap_t *cache);
+uint64_t source_clock_video_bootstrap_codec_epoch(
+    source_clock_video_bootstrap_t *cache);
+
+#ifdef SOURCE_CLOCK_TEST_HOOKS
+void source_clock_video_bootstrap_test_fail_alloc_after(
+    source_clock_video_bootstrap_t *cache, int64_t successful_allocations);
+void source_clock_video_bootstrap_test_set_codec_epoch(
+    source_clock_video_bootstrap_t *cache, uint64_t codec_epoch);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
