diff --git a/renderers/source_clock_video_bootstrap_test.c b/renderers/source_clock_video_bootstrap_test.c
new file mode 100644
index 00000000..734b6c0f
--- /dev/null
+++ b/renderers/source_clock_video_bootstrap_test.c
@@ -0,0 +1,744 @@
+#include "source_clock_video_bootstrap.h"
+
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static void write_bits(unsigned char *bytes, size_t *bit_position,
+                       unsigned value, unsigned count) {
+    unsigned index;
+    for (index = count; index != 0; --index) {
+        unsigned bit = (value >> (index - 1U)) & 1U;
+        size_t byte_index = *bit_position / 8U;
+        unsigned shift = 7U - (unsigned)(*bit_position % 8U);
+        bytes[byte_index] = (unsigned char)(bytes[byte_index] | (bit << shift));
+        (*bit_position)++;
+    }
+}
+
+static void write_ue(unsigned char *bytes, size_t *bit_position, unsigned value) {
+    unsigned code_num = value + 1U;
+    unsigned bits = 0;
+    unsigned copy = code_num;
+    unsigned index;
+    while (copy != 0) {
+        bits++;
+        copy >>= 1U;
+    }
+    for (index = 1; index < bits; ++index) write_bits(bytes, bit_position, 0, 1);
+    write_bits(bytes, bit_position, code_num, bits);
+}
+
+static unsigned char *rbsp_to_ebsp(const unsigned char *rbsp, size_t rbsp_size,
+                                   size_t minimum_size, size_t *ebsp_size) {
+    size_t capacity = rbsp_size * 2U + minimum_size + 8U;
+    unsigned char *ebsp = (unsigned char *)calloc(capacity, 1U);
+    size_t input_index;
+    size_t output_index = 0;
+    unsigned zero_count = 0;
+    assert(ebsp != NULL);
+    for (input_index = 0; input_index < rbsp_size; ++input_index) {
+        unsigned char byte = rbsp[input_index];
+        if (zero_count >= 2U && byte <= 3U) {
+            ebsp[output_index++] = 3U;
+            zero_count = 0;
+        }
+        ebsp[output_index++] = byte;
+        if (byte == 0) zero_count++; else zero_count = 0;
+    }
+    if (output_index < minimum_size) {
+        memset(ebsp + output_index, 0x55, minimum_size - output_index);
+        output_index = minimum_size;
+    }
+    *ebsp_size = output_index;
+    return ebsp;
+}
+
+static unsigned char *make_sps(unsigned id, size_t minimum_size, int with_epb,
+                               size_t *nal_size) {
+    unsigned char rbsp[32] = { 0 };
+    unsigned char *payload;
+    unsigned char *nal;
+    size_t bit_position = 0;
+    size_t rbsp_size;
+    size_t payload_size;
+
+    write_bits(rbsp, &bit_position, with_epb ? 0U : 100U, 8);
+    write_bits(rbsp, &bit_position, 0U, 8);
+    write_bits(rbsp, &bit_position, with_epb ? 1U : 0U, 8);
+    write_ue(rbsp, &bit_position, id);
+    write_bits(rbsp, &bit_position, 1U, 1);
+    while ((bit_position % 8U) != 0) write_bits(rbsp, &bit_position, 0U, 1);
+    rbsp_size = bit_position / 8U;
+    if (with_epb) {
+        payload = rbsp_to_ebsp(rbsp, rbsp_size,
+                               minimum_size > 0 ? minimum_size - 1U : 0U,
+                               &payload_size);
+    } else {
+        payload_size = rbsp_size;
+        if (payload_size + 1U < minimum_size) payload_size = minimum_size - 1U;
+        payload = (unsigned char *)malloc(payload_size);
+        assert(payload != NULL);
+        memset(payload, 0x55, payload_size);
+        memcpy(payload, rbsp, rbsp_size);
+    }
+    nal = (unsigned char *)malloc(payload_size + 1U);
+    assert(nal != NULL);
+    nal[0] = 0x67U;
+    memcpy(nal + 1U, payload, payload_size);
+    free(payload);
+    *nal_size = payload_size + 1U;
+    return nal;
+}
+
+static unsigned char *make_pps(unsigned pps_id, unsigned sps_id,
+                               size_t minimum_size, size_t *nal_size) {
+    unsigned char bits[32] = { 0 };
+    unsigned char *nal;
+    size_t bit_position = 0;
+    size_t payload_size;
+    write_ue(bits, &bit_position, pps_id);
+    write_ue(bits, &bit_position, sps_id);
+    write_bits(bits, &bit_position, 1U, 1);
+    while ((bit_position % 8U) != 0) write_bits(bits, &bit_position, 0U, 1);
+    payload_size = bit_position / 8U;
+    if (payload_size + 1U < minimum_size) payload_size = minimum_size - 1U;
+    nal = (unsigned char *)malloc(payload_size + 1U);
+    assert(nal != NULL);
+    memset(nal, 0x55, payload_size + 1U);
+    nal[0] = 0x68U;
+    memcpy(nal + 1U, bits, bit_position / 8U);
+    *nal_size = payload_size + 1U;
+    return nal;
+}
+
+static source_clock_video_bootstrap_result_t push_nal(
+    source_clock_video_bootstrap_t *cache, uint64_t session_epoch,
+    const unsigned char *nal,
+    size_t nal_size, unsigned start_code_size) {
+    unsigned char *annexb;
+    source_clock_video_bootstrap_result_t result;
+    assert(start_code_size == 3U || start_code_size == 4U);
+    annexb = (unsigned char *)calloc(nal_size + start_code_size, 1U);
+    assert(annexb != NULL);
+    annexb[start_code_size - 1U] = 1U;
+    memcpy(annexb + start_code_size, nal, nal_size);
+    result = source_clock_video_bootstrap_push_annexb_for_session(
+        cache, session_epoch, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264,
+        annexb, nal_size + start_code_size);
+    free(annexb);
+    return result;
+}
+
+static source_clock_video_bootstrap_result_t push_two_nals(
+    source_clock_video_bootstrap_t *cache, uint64_t session_epoch,
+    const unsigned char *first, size_t first_size,
+    const unsigned char *second, size_t second_size) {
+    size_t annexb_size = 4U + first_size + 4U + second_size;
+    unsigned char *annexb = (unsigned char *)calloc(annexb_size, 1U);
+    source_clock_video_bootstrap_result_t result;
+    assert(annexb != NULL);
+    annexb[3] = 1U;
+    memcpy(annexb + 4U, first, first_size);
+    annexb[4U + first_size + 3U] = 1U;
+    memcpy(annexb + 4U + first_size + 4U, second, second_size);
+    result = source_clock_video_bootstrap_push_annexb_for_session(
+        cache, session_epoch, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264,
+        annexb, annexb_size);
+    free(annexb);
+    return result;
+}
+
+static int contains_bytes(const unsigned char *data, size_t size,
+                          const unsigned char *needle, size_t needle_size) {
+    size_t index;
+    if (needle_size > size) return 0;
+    for (index = 0; index <= size - needle_size; ++index) {
+        if (memcmp(data + index, needle, needle_size) == 0) return 1;
+    }
+    return 0;
+}
+
+static void assert_same_snapshot(const source_clock_video_bootstrap_snapshot_t *left,
+                                 const source_clock_video_bootstrap_snapshot_t *right) {
+    assert(left->session_epoch == right->session_epoch);
+    assert(left->codec_epoch == right->codec_epoch);
+    assert(left->sps_id == right->sps_id);
+    assert(left->pps_id == right->pps_id);
+    assert(left->sps_size == right->sps_size);
+    assert(left->pps_size == right->pps_size);
+    assert(memcmp(left->sps, right->sps, left->sps_size) == 0);
+    assert(memcmp(left->pps, right->pps, left->pps_size) == 0);
+}
+
+static void test_separate_out_of_order_epb_and_caller_copy(void) {
+    source_clock_video_bootstrap_t *cache = source_clock_video_bootstrap_create();
+    unsigned char *sps;
+    unsigned char *replacement;
+    unsigned char *pps;
+    size_t sps_size;
+    size_t replacement_size;
+    size_t pps_size;
+    source_clock_video_bootstrap_snapshot_t before = { 0 };
+    source_clock_video_bootstrap_snapshot_t after = { 0 };
+    static const unsigned char idr[] = { 0x65U, 0x88U, 0x84U };
+    static const unsigned char epb[] = { 0x00U, 0x00U, 0x03U };
+
+    assert(cache != NULL);
+    assert(source_clock_video_bootstrap_session_start_for_codec(
+               cache, 17U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED);
+    sps = make_sps(3U, 20U, 1, &sps_size);
+    replacement = make_sps(3U, 24U, 0, &replacement_size);
+    pps = make_pps(9U, 3U, 8U, &pps_size);
+    assert(contains_bytes(sps, sps_size, epb, sizeof(epb)));
+    assert(push_nal(cache, 17U, pps, pps_size, 3U) == SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED);
+    assert(source_clock_video_bootstrap_snapshot_copy_for_pps(
+               cache, 17U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264, 9U, &before) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_NOT_READY);
+    assert(push_nal(cache, 17U, sps, sps_size, 4U) == SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED);
+    assert(source_clock_video_bootstrap_snapshot_copy_for_pps(
+               cache, 17U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264, 9U, &before) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_READY);
+    assert(before.session_epoch == 17U && before.sps_id == 3U && before.pps_id == 9U);
+    assert(before.codec_epoch == 2U);
+    assert(push_nal(cache, 17U, replacement, replacement_size, 4U) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED);
+    assert(source_clock_video_bootstrap_snapshot_copy_for_pps(
+               cache, 17U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264, 9U, &after) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_READY);
+    assert(after.codec_epoch == 3U);
+    assert(after.sps_size == replacement_size);
+    assert(before.sps_size == sps_size && memcmp(before.sps, sps, sps_size) == 0);
+    source_clock_video_bootstrap_snapshot_free(&after);
+    assert(push_nal(cache, 17U, idr, sizeof(idr), 3U) == SOURCE_CLOCK_VIDEO_BOOTSTRAP_UNCHANGED);
+    assert(source_clock_video_bootstrap_snapshot_copy_for_pps(
+               cache, 17U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264, 9U, &after) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_READY);
+    assert(after.codec_epoch == 3U);
+    source_clock_video_bootstrap_snapshot_free(&before);
+    source_clock_video_bootstrap_snapshot_free(&after);
+    free(sps);
+    free(replacement);
+    free(pps);
+    source_clock_video_bootstrap_destroy(cache);
+}
+
+static void test_mixed_start_codes_and_pps_sps_integrity(void) {
+    source_clock_video_bootstrap_t *cache = source_clock_video_bootstrap_create();
+    unsigned char *sps;
+    unsigned char *wrong_pps;
+    unsigned char *right_pps;
+    unsigned char *annexb;
+    size_t sps_size;
+    size_t wrong_size;
+    size_t right_size;
+    size_t total;
+    source_clock_video_bootstrap_snapshot_t snapshot = { 0 };
+
+    assert(cache != NULL);
+    assert(source_clock_video_bootstrap_session_start_for_codec(
+               cache, 18U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED);
+    sps = make_sps(2U, 12U, 0, &sps_size);
+    wrong_pps = make_pps(4U, 3U, 6U, &wrong_size);
+    right_pps = make_pps(5U, 2U, 6U, &right_size);
+    total = 4U + sps_size + 3U + wrong_size;
+    annexb = (unsigned char *)calloc(total, 1U);
+    assert(annexb != NULL);
+    annexb[3] = 1U;
+    memcpy(annexb + 4U, sps, sps_size);
+    annexb[4U + sps_size + 2U] = 1U;
+    memcpy(annexb + 4U + sps_size + 3U, wrong_pps, wrong_size);
+    assert(source_clock_video_bootstrap_push_annexb_for_session(
+               cache, 18U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264, annexb, total) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED);
+    assert(source_clock_video_bootstrap_snapshot_copy_for_pps(
+               cache, 18U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264, 4U, &snapshot) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_NOT_READY);
+    assert(push_nal(cache, 18U, right_pps, right_size, 3U) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED);
+    assert(source_clock_video_bootstrap_snapshot_copy_for_pps(
+               cache, 18U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264, 5U, &snapshot) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_READY);
+    assert(snapshot.sps_id == 2U && snapshot.pps_id == 5U);
+    source_clock_video_bootstrap_snapshot_free(&snapshot);
+    free(annexb);
+    free(sps);
+    free(wrong_pps);
+    free(right_pps);
+    source_clock_video_bootstrap_destroy(cache);
+}
+
+static void test_session_reset_and_hevc_gate(void) {
+    source_clock_video_bootstrap_t *cache = source_clock_video_bootstrap_create();
+    unsigned char *sps;
+    unsigned char *pps;
+    size_t sps_size;
+    size_t pps_size;
+    source_clock_video_bootstrap_snapshot_t snapshot = { 0 };
+    uint64_t codec_epoch;
+
+    assert(cache != NULL);
+    assert(source_clock_video_bootstrap_session_start_for_codec(
+               cache, 1U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED);
+    sps = make_sps(0U, 12U, 0, &sps_size);
+    pps = make_pps(0U, 0U, 6U, &pps_size);
+    assert(push_nal(cache, 1U, sps, sps_size, 4U) == SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED);
+    assert(push_nal(cache, 1U, pps, pps_size, 4U) == SOURCE_CLOCK_VIDEO_BOOTSTRAP_CHANGED);
+    assert(source_clock_video_bootstrap_snapshot_copy_for_pps(
+               cache, 1U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_H264, 0U, &snapshot) ==
+           SOURCE_CLOCK_VIDEO_BOOTSTRAP_READY);
+    source_clock_video_bootstrap_snapshot_free(&snapshot);
+    codec_epoch = source_clock_video_bootstrap_codec_epoch(cache);
+    assert(source_clock_video_bootstrap_snapshot_copy_for_pps(
+               cache, 1U, SOURCE_CLOCK_VIDEO_BOOTSTRAP_HEVC, 0U, &snapshot) ==
