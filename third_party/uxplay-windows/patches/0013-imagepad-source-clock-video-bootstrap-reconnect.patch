+static unsigned read_u16(const unsigned char *p) {
+    return ((unsigned)p[0] << 8) | (unsigned)p[1];
+}
+
+static unsigned read_u32(const unsigned char *p) {
+    return ((unsigned)p[0] << 24) | ((unsigned)p[1] << 16) |
+           ((unsigned)p[2] << 8) | (unsigned)p[3];
+}
+
+static int read_full(TEST_SOCKET socket_fd, unsigned char *data, size_t length) {
+    while (length > 0) {
+        int received = recv(socket_fd, (char *)data, (int)length, 0);
+        if (received <= 0) return 0;
+        data += received;
+        length -= (size_t)received;
+    }
+    return 1;
+}
+
+static void write_bits(unsigned char *bytes, size_t *bit_position,
+                       unsigned value, unsigned count) {
+    unsigned index;
+    for (index = count; index != 0; --index) {
+        unsigned bit = (value >> (index - 1U)) & 1U;
+        size_t byte_index = *bit_position / 8U;
+        unsigned shift = 7U - (unsigned)(*bit_position % 8U);
+        bytes[byte_index] = (unsigned char)(bytes[byte_index] | (bit << shift));
+        (*bit_position)++;
+    }
+}
+
+static void write_ue(unsigned char *bytes, size_t *bit_position, unsigned value) {
+    unsigned code_num = value + 1U;
+    unsigned bits = 0;
+    unsigned copy = code_num;
+    unsigned index;
+    while (copy != 0) {
+        bits++;
+        copy >>= 1U;
+    }
+    for (index = 1; index < bits; ++index) write_bits(bytes, bit_position, 0, 1);
+    write_bits(bytes, bit_position, code_num, bits);
+}
+
+static size_t make_sps(unsigned char *nal, unsigned id) {
+    unsigned char payload[8] = { 0x42, 0x00, 0x1e, 0, 0, 0, 0, 0 };
+    size_t bit_position = 24;
+    nal[0] = 0x67;
+    write_ue(payload, &bit_position, id);
+    write_bits(payload, &bit_position, 1, 1);
+    while ((bit_position % 8U) != 0) write_bits(payload, &bit_position, 0, 1);
+    memcpy(nal + 1, payload, bit_position / 8U);
+    return 1U + bit_position / 8U;
+}
+
+static size_t make_pps(unsigned char *nal, unsigned pps_id, unsigned sps_id) {
+    unsigned char payload[8] = { 0 };
+    size_t bit_position = 0;
+    nal[0] = 0x68;
+    write_ue(payload, &bit_position, pps_id);
+    write_ue(payload, &bit_position, sps_id);
+    write_bits(payload, &bit_position, 1, 1);
+    while ((bit_position % 8U) != 0) write_bits(payload, &bit_position, 0, 1);
+    memcpy(nal + 1, payload, bit_position / 8U);
+    return 1U + bit_position / 8U;
+}
+
+static size_t make_idr(unsigned char *nal, unsigned pps_id) {
+    unsigned char payload[8] = { 0 };
+    size_t bit_position = 0;
+    nal[0] = 0x65;
+    write_ue(payload, &bit_position, 0);
+    write_ue(payload, &bit_position, 2);
+    write_ue(payload, &bit_position, pps_id);
+    write_bits(payload, &bit_position, 1, 1);
+    while ((bit_position % 8U) != 0) write_bits(payload, &bit_position, 0, 1);
+    memcpy(nal + 1, payload, bit_position / 8U);
+    return 1U + bit_position / 8U;
+}
