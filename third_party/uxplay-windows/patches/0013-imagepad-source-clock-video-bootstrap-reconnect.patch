+static void test_session_end_cancels_blocked_video_send(void) {
+    const char *token = "00112233445566778899aabbccddeeff";
+    const size_t large_frame_size = 8U * 1024U * 1024U;
+    char video_endpoint[64];
+    unsigned char sps[32], pps[32], idr[32], frame[128];
+    unsigned char *large_frame;
+    size_t sps_size = make_sps(sps, 0);
+    size_t pps_size = make_pps(pps, 0, 0);
+    size_t idr_size = make_idr(idr, 0);
+    size_t frame_size;
+    uint64_t started_ms;
+    uint64_t elapsed_ms;
+    capture_t capture;
+    source_clock_renderer_t *renderer;
+
+    capture_init(&capture);
+    capture.stall_first_video_media_index = 2;
+    capture_start(&capture);
+    snprintf(video_endpoint, sizeof(video_endpoint), "127.0.0.1:%u", capture.port);
+    renderer = source_clock_renderer_create(video_endpoint, "127.0.0.1:1", token,
+                                            "receiver-b2-blocked-send");
+    assert(renderer != NULL);
+    source_clock_renderer_session_start(renderer);
+    assert(wait_for_connections(&capture, 1));
+    assert(wait_for_captured_frames(&capture, 0, 2));
+    sleep_ms(20);
+    frame_size = annexb_one(frame, sps, sps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 1, 0));
+    frame_size = annexb_one(frame, pps, pps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 2, 0));
+    large_frame = (unsigned char *)malloc(large_frame_size);
+    assert(large_frame != NULL);
+    memset(large_frame, 0x55, large_frame_size);
+    large_frame[0] = 0;
+    large_frame[1] = 0;
+    large_frame[2] = 0;
+    large_frame[3] = 1;
+    memcpy(large_frame + 4U, idr, idr_size);
+    large_frame[32] = 0;
+    large_frame[33] = 0;
+    large_frame[34] = 0;
+    large_frame[35] = 1;
+    large_frame[36] = 0x06;
+    assert(source_clock_renderer_push_video(renderer, large_frame,
+                                            large_frame_size, 3, 0));
+    free(large_frame);
+    if (!wait_for_stalled_payload(&capture)) {
+        unsigned index;
+        pthread_mutex_lock(&capture.mutex);
+        fprintf(stderr, "blocked-send capture: connections=%u frames=%u dropped=%llu\n",
+                capture.connection_count, capture.connections[0].frame_count,
+                (unsigned long long)source_clock_renderer_video_dropped(renderer));
+        for (index = 0; index < capture.connections[0].frame_count; ++index) {
+            captured_frame_t *captured = &capture.connections[0].frames[index];
+            fprintf(stderr, "  frame[%u] stream=%u flags=%u size=%zu\n",
+                    index, captured->stream, captured->flags, captured->size);
+        }
+        pthread_mutex_unlock(&capture.mutex);
+        assert(0 && "video sender did not reach the blocked receiver payload");
+    }
+    sleep_ms(100);
+    started_ms = monotonic_ms();
+    source_clock_renderer_session_end(renderer);
+    elapsed_ms = monotonic_ms() - started_ms;
+    assert(elapsed_ms < 5000U);
+    source_clock_renderer_destroy(renderer);
+    capture_stop(&capture);
+}
