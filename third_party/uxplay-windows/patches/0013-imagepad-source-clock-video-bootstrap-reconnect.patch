+/* Test-only hook; the implementation is added only after this test is RED. */
+extern void source_clock_renderer_set_video_sequence_for_test(
+    source_clock_renderer_t *renderer, uint32_t sequence);
+
+static void test_video_sequence_is_canonical_and_fail_closed(void) {
+    const char *token = "00112233445566778899aabbccddeeff";
+    char video_endpoint[64];
+    unsigned char sps[32], pps[32], idr[32], frame[128];
+    unsigned char audio[] = { 0x8c, 0x01, 0x02, 0x03 };
+    size_t sps_size = make_sps(sps, 0);
+    size_t pps_size = make_pps(pps, 0, 0);
+    size_t idr_size = make_idr(idr, 0);
+    size_t frame_size;
+    unsigned first_count = 0;
+    unsigned second_count = 0;
+    unsigned index;
+    unsigned commits_before;
+    unsigned overflow_count = 0;
+    uint64_t drops_before;
+    capture_t capture;
+    connect_pause_t reconnect_pause;
+    queue_commit_observation_t commits;
+    captured_connection_t first_snapshot;
+    captured_connection_t second_snapshot;
+    captured_connection_t overflow_snapshot;
+    source_clock_renderer_t *renderer;
+    captured_frame_t *first_media[8];
+    captured_frame_t *second_media[8];
+    captured_frame_t *overflow_media[8];
+
+    capture_init(&capture);
+    capture_start(&capture);
+    snprintf(video_endpoint, sizeof(video_endpoint), "127.0.0.1:%u", capture.port);
+    renderer = source_clock_renderer_create(video_endpoint, "127.0.0.1:1", token,
+                                            "receiver-sequence-canonical");
+    assert(renderer != NULL);
+    queue_commit_observation_init(&commits);
+    connect_pause_init(&reconnect_pause);
+    source_clock_renderer_set_queue_commit_hook(
+        renderer, observe_video_queue_commit, &commits);
+    source_clock_renderer_session_start(renderer);
+    assert(wait_for_connections(&capture, 1));
+    assert(wait_for_connected_consumers(renderer, 1));
+    assert(wait_for_connected_consumers_exact(renderer, 1));
+
+    frame_size = annexb_one(frame, sps, sps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 1, 0));
+    frame_size = annexb_one(frame, pps, pps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 2, 0));
+    frame_size = annexb_one(frame, idr, idr_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 3, 0));
+    assert(wait_for_media(&capture, 0, 2));
+    assert(source_clock_renderer_push_audio(renderer, audio, sizeof(audio), 4, 0));
+    frame_size = make_p_frame(frame);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 5, 0));
+    assert(wait_for_media(&capture, 0, 3));
+
+    /* Install only after initial attachment; hold reconnect before its watermark. */
+    source_clock_renderer_set_after_connect_hook(
+        renderer, pause_after_connect, &reconnect_pause);
+    assert(capture_shutdown_active_client(&capture));
+    frame_size = make_p_frame(frame);
+    for (index = 0; index < 100U && !connect_pause_entered(&reconnect_pause); ++index) {
+        assert(source_clock_renderer_push_video(renderer, frame, frame_size, 6, 0));
+        sleep_ms(20);
+    }
+    assert(connect_pause_entered(&reconnect_pause));
+    assert(wait_for_connected_consumers_exact(renderer, 0));
+    connect_pause_release(&reconnect_pause);
+    assert(wait_for_connections(&capture, 2));
+    assert(wait_for_connected_consumers(renderer, 1));
+    assert(wait_for_connected_consumers_exact(renderer, 1));
+    source_clock_renderer_set_after_connect_hook(renderer, NULL, NULL);
+    frame_size = annexb_one(frame, sps, sps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 7, 0));
+    frame_size = annexb_one(frame, pps, pps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 8, 0));
+    frame_size = annexb_one(frame, idr, idr_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 9, 0));
+    frame_size = make_p_frame(frame);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 10, 0));
+    assert(wait_for_media(&capture, 1, 3));
+
+    assert(capture_copy_connection(&capture, 0, &first_snapshot));
+    assert(capture_copy_connection(&capture, 1, &second_snapshot));
+    {
+        for (index = 0; index < first_snapshot.frame_count; ++index) {
+            if (first_snapshot.frames[index].stream != 1U) continue;
+            assert(first_count < 8U);
+            first_media[first_count++] = &first_snapshot.frames[index];
+        }
+        for (index = 0; index < second_snapshot.frame_count; ++index) {
+            if (second_snapshot.frames[index].stream != 1U) continue;
+            assert(second_count < 8U);
+            second_media[second_count++] = &second_snapshot.frames[index];
+        }
+        assert(first_count == 3U);
+        assert(second_count == 3U);
+        assert((first_media[0]->flags & SOURCE_CLOCK_FLAG_CONFIG) != 0);
+        assert(contains_bytes(first_media[0]->data, first_media[0]->size, sps, sps_size));
+        assert(contains_bytes(first_media[0]->data, first_media[0]->size, pps, pps_size));
+        assert((first_media[1]->flags & SOURCE_CLOCK_FLAG_KEYFRAME) != 0);
+        assert(first_media[1]->size == idr_size + 4U);
+        assert(memcmp(first_media[1]->data + 4U, idr, idr_size) == 0);
+        assert(first_media[0]->sequence != 0U);
+        assert(first_media[1]->sequence == first_media[0]->sequence);
+        assert((second_media[0]->flags & SOURCE_CLOCK_FLAG_CONFIG) != 0);
+        assert(contains_bytes(second_media[0]->data, second_media[0]->size, sps, sps_size));
+        assert(contains_bytes(second_media[0]->data, second_media[0]->size, pps, pps_size));
+        assert((second_media[1]->flags & SOURCE_CLOCK_FLAG_KEYFRAME) != 0);
+        assert(second_media[1]->size == idr_size + 4U);
+        assert(memcmp(second_media[1]->data + 4U, idr, idr_size) == 0);
+        assert(second_media[0]->sequence != 0U);
+        assert(second_media[1]->sequence == second_media[0]->sequence);
+        assert(second_media[0]->sequence > first_media[first_count - 1U]->sequence);
+        /* Only the synthetic CONFIG/matching IDR pair shares a sequence. Gaps are OK. */
+        for (index = 2; index < first_count; ++index)
+            assert(first_media[index]->sequence > first_media[index - 1U]->sequence);
+        for (index = 2; index < second_count; ++index)
+            assert(second_media[index]->sequence > second_media[index - 1U]->sequence);
+
+        source_clock_renderer_set_video_sequence_for_test(
+            renderer, first_media[0]->sequence);
+        commits_before = queue_commit_count(&commits);
+        drops_before = source_clock_renderer_video_dropped(renderer);
+        frame_size = make_p_frame(frame);
+        assert(source_clock_renderer_push_video(renderer, frame, frame_size, 10, 0));
+        assert(wait_for_video_queue_commit(&commits, commits_before + 1U));
+        assert(queue_commit_count(&commits) == commits_before + 1U);
+        /* Bootstrap is complete and the queue is drained: this is a send-time drop. */
+        assert(wait_for_video_drop(renderer, drops_before + 1U));
+        assert(source_clock_renderer_video_dropped(renderer) == drops_before + 1U);
+        assert(captured_media(&capture, 1) == second_count);
+    }
+
+    source_clock_renderer_set_video_sequence_for_test(renderer, UINT32_MAX - 1U);
+    commits_before = queue_commit_count(&commits);
+    frame_size = make_p_frame(frame);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 11, 0));
+    assert(wait_for_video_queue_commit(&commits, commits_before + 1U));
+    assert(queue_commit_count(&commits) == commits_before + 1U);
+    assert(wait_for_media(&capture, 1, second_count + 1U));
+    assert(capture_copy_connection(&capture, 1, &overflow_snapshot));
+    for (index = 0; index < overflow_snapshot.frame_count; ++index) {
+        if (overflow_snapshot.frames[index].stream != 1U) continue;
+        assert(overflow_count < 8U);
+        overflow_media[overflow_count++] = &overflow_snapshot.frames[index];
+    }
+    assert(overflow_count == second_count + 1U);
+    assert(overflow_media[overflow_count - 1U]->sequence == UINT32_MAX);
+    assert(overflow_media[overflow_count - 1U]->size == frame_size);
+    assert(memcmp(overflow_media[overflow_count - 1U]->data, frame, frame_size) == 0);
+    for (index = 2; index < overflow_count; ++index)
+        assert(overflow_media[index]->sequence > overflow_media[index - 1U]->sequence);
+
+    commits_before = queue_commit_count(&commits);
+    assert(!source_clock_renderer_push_video(renderer, frame, frame_size, 12, 0));
+    assert(queue_commit_count(&commits) == commits_before);
+    assert(!source_clock_renderer_push_video(renderer, frame, frame_size, 13, 0));
+    assert(queue_commit_count(&commits) == commits_before);
+    assert(captured_media(&capture, 1) == overflow_count);
+    assert(source_clock_renderer_push_audio(renderer, audio, sizeof(audio), 14, 0));
+    source_clock_renderer_session_end(renderer);
+    source_clock_renderer_session_start(renderer);
+    assert(!source_clock_renderer_push_video(renderer, frame, frame_size, 15, 0));
+    assert(queue_commit_count(&commits) == commits_before);
+    assert(source_clock_renderer_push_audio(renderer, audio, sizeof(audio), 16, 0));
+    source_clock_renderer_destroy(renderer);
+    capture_stop(&capture);
+    connect_pause_destroy(&reconnect_pause);
+    queue_commit_observation_destroy(&commits);
+    /* Joined capture owns the final wire evidence, including any session restart. */
+    {
+        unsigned connection;
+        unsigned total_video = 0;
+        unsigned max_originals = 0;
+        assert(capture.connection_count <= MAX_CONNECTIONS);
+        for (connection = 0; connection < capture.connection_count; ++connection) {
+            captured_connection_t *captured = &capture.connections[connection];
+            assert(captured->frame_count < MAX_FRAMES);
+            for (index = 0; index < captured->frame_count; ++index) {
+                captured_frame_t *media = &captured->frames[index];
+                if (media->stream != 1U) continue;
+                assert(media->sequence > 1U);
+                if (media->sequence == UINT32_MAX) max_originals++;
+                total_video++;
+            }
+        }
+        assert(max_originals == 1U);
+        assert(total_video == first_count + overflow_count);
+    }
+}
+
+int main(void) {
+#ifdef _WIN32
+    WSADATA wsa;
+    assert(WSAStartup(MAKEWORD(2, 2), &wsa) == 0);
+#endif
+    test_receiver_bootstrap_order_and_watermark();
+    test_idr_snapshot_validation_and_codec_reset();
+    test_partial_bootstrap_disconnect_restarts_from_new_idr();
+    test_session_end_cancels_blocked_video_send();
+    test_session_end_during_connect_sends_no_stale_start();
+    test_h264_recovers_within_session_started_as_h265();
+    test_codec_change_cannot_release_old_epoch_frame();
+    test_video_sequence_is_canonical_and_fail_closed();
+#ifdef _WIN32
+    WSACleanup();
+#endif
+    puts("source_clock_video_receiver_bootstrap: PASS");
+    return 0;
+}
