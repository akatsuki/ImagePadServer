+    frame_size = annexb_one(frame, pps, pps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 2, 0));
+    frame_size = annexb_one(frame, idr, idr_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 3, 0));
+    assert(wait_for_media(&capture, 0, 2));
+    source_clock_renderer_destroy(renderer);
+    capture_stop(&capture);
+    {
+        captured_connection_t *connection = &capture.connections[0];
+        captured_frame_t *media[4];
+        unsigned index;
+        unsigned media_index = 0;
+        for (index = 0; index < connection->frame_count; ++index) {
+            if (connection->frames[index].stream == 1U && media_index < 4U)
+                media[media_index++] = &connection->frames[index];
+        }
+        assert(media_index == 2U);
+        assert((media[0]->flags & SOURCE_CLOCK_FLAG_CONFIG) != 0);
+        assert((media[1]->flags & SOURCE_CLOCK_FLAG_KEYFRAME) != 0);
+    }
+}
+
+static void test_codec_change_cannot_release_old_epoch_frame(void) {
+    const char *token = "00112233445566778899aabbccddeeff";
+    char video_endpoint[64];
+    unsigned char sps[32], pps[32], idr[32], frame[128];
+    size_t sps_size = make_sps(sps, 0);
+    size_t pps_size = make_pps(pps, 0, 0);
+    size_t idr_size = make_idr(idr, 0);
+    size_t frame_size;
+    capture_t capture;
+    connect_pause_t send_pause;
+    connect_pause_t codec_pause;
+    codec_change_args_t change;
+    pthread_t change_thread;
+    source_clock_renderer_t *renderer;
+
+    capture_init(&capture);
+    capture_start(&capture);
+    connect_pause_init(&send_pause);
+    connect_pause_init(&codec_pause);
+    snprintf(video_endpoint, sizeof(video_endpoint), "127.0.0.1:%u", capture.port);
+    renderer = source_clock_renderer_create(video_endpoint, "127.0.0.1:1", token,
+                                            "receiver-b2-codec-race");
+    assert(renderer != NULL);
+    source_clock_renderer_session_start(renderer);
+    assert(wait_for_connections(&capture, 1));
+    assert(wait_for_captured_frames(&capture, 0, 2));
+    assert(wait_for_connected_consumers(renderer, 1));
+    assert(wait_for_connected_consumers_exact(renderer, 1));
+    sleep_ms(20);
+    frame_size = annexb_one(frame, sps, sps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 1, 0));
+    frame_size = annexb_one(frame, pps, pps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 2, 0));
+    frame_size = annexb_one(frame, idr, idr_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 3, 0));
+    assert(wait_for_media(&capture, 0, 2));
+    source_clock_renderer_set_before_video_send_lock_hook(
+        renderer, pause_test_hook, &send_pause);
+    source_clock_renderer_set_video_codec_change_hook(
+        renderer, pause_test_hook, &codec_pause);
+    frame_size = make_p_frame(frame);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 4, 0));
+    connect_pause_wait(&send_pause);
+    change.renderer = renderer;
+    change.codec = SOURCE_CLOCK_VIDEO_H265;
+    assert(pthread_create(&change_thread, NULL, change_codec_main, &change) == 0);
+    connect_pause_wait(&codec_pause);
+    connect_pause_release(&send_pause);
+    sleep_ms(100);
+    assert(captured_media(&capture, 0) == 2);
+    connect_pause_release(&codec_pause);
+    pthread_join(change_thread, NULL);
+    sleep_ms(100);
+    assert(captured_media(&capture, 0) == 2);
+    source_clock_renderer_destroy(renderer);
+    capture_stop(&capture);
+    connect_pause_destroy(&send_pause);
+    connect_pause_destroy(&codec_pause);
+}
