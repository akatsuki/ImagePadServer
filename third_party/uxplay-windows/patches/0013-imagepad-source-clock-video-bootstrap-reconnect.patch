+static size_t annexb_one(unsigned char *frame, const unsigned char *nal, size_t nal_size) {
+    frame[0] = 0;
+    frame[1] = 0;
+    frame[2] = 0;
+    frame[3] = 1;
+    memcpy(frame + 4, nal, nal_size);
+    return 4U + nal_size;
+}
