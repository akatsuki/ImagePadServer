+static int capture_shutdown_active_client(capture_t *capture) {
+    TEST_SOCKET client;
+    struct linger reset = { 1, 0 };
+    pthread_mutex_lock(&capture->mutex);
+    client = capture->active_client;
+    if (client == TEST_INVALID_SOCKET) {
+        pthread_mutex_unlock(&capture->mutex);
+        return 0;
+    }
+    assert(setsockopt(client, SOL_SOCKET, SO_LINGER,
+                      (const char *)&reset, sizeof(reset)) == 0);
+    (void)shutdown(client, 2);
+    pthread_mutex_unlock(&capture->mutex);
+    return 1;
+}
+
+static void *capture_main(void *argument) {
+    capture_t *capture = (capture_t *)argument;
+    while (!atomic_load(&capture->stopping)) {
+        TEST_SOCKET client = accept(capture->listener, NULL, NULL);
+        unsigned connection_index;
+        if (client == TEST_INVALID_SOCKET) break;
+        pthread_mutex_lock(&capture->mutex);
+        capture->active_client = client;
+        connection_index = capture->connection_count++;
+        pthread_mutex_unlock(&capture->mutex);
+        if (connection_index < MAX_CONNECTIONS) {
+            unsigned char header[40];
+            unsigned video_media_received = 0;
+            while (!atomic_load(&capture->stopping) &&
+                   read_full(client, header, sizeof(header))) {
+                unsigned payload_size = read_u32(header + 12);
+                captured_frame_t frame;
+                size_t bytes_to_read = payload_size;
+                int partial_disconnect = 0;
+                assert(memcmp(header, "IPAF", 4) == 0);
+                assert(read_u16(header + 6) == 40);
+                if (header[8] == 1U) video_media_received++;
+                if (connection_index == 0 && header[8] == 1U &&
+                    capture->stall_first_video_media_index != 0 &&
+                    video_media_received == capture->stall_first_video_media_index) {
+                    pthread_mutex_lock(&capture->mutex);
+                    capture->stalled_payload = 1;
+                    pthread_mutex_unlock(&capture->mutex);
+                    while (!atomic_load(&capture->stopping)) sleep_ms(10);
+                    break;
+                }
+                assert(payload_size <= MAX_PAYLOAD);
+                if (connection_index == 0 &&
+                    header[8] == 1U &&
+                    capture->disconnect_first_payload_after_bytes != 0 &&
+                    capture->disconnect_first_payload_after_bytes < payload_size) {
+                    bytes_to_read = capture->disconnect_first_payload_after_bytes;
+                    partial_disconnect = 1;
+                }
+                memset(&frame, 0, sizeof(frame));
+                frame.stream = header[8];
+                frame.codec = header[9];
+                frame.flags = read_u16(header + 10);
+                frame.sequence = read_u32(header + 16);
+                frame.size = bytes_to_read;
+                if (bytes_to_read != 0 && !read_full(client, frame.data, bytes_to_read)) break;
+                pthread_mutex_lock(&capture->mutex);
+                if (capture->connections[connection_index].frame_count < MAX_FRAMES) {
+                    capture->connections[connection_index]
+                        .frames[capture->connections[connection_index].frame_count++] = frame;
+                }
+                pthread_mutex_unlock(&capture->mutex);
+                if (partial_disconnect) {
+                    struct linger reset = { 1, 0 };
+                    setsockopt(client, SOL_SOCKET, SO_LINGER,
+                               (const char *)&reset, sizeof(reset));
+                    break;
+                }
+            }
+        }
+        pthread_mutex_lock(&capture->mutex);
+        test_close(client);
+        capture->active_client = TEST_INVALID_SOCKET;
+        pthread_mutex_unlock(&capture->mutex);
+    }
+    return NULL;
+}
+
+static void capture_init(capture_t *capture) {
+    struct sockaddr_in address;
+    int address_length = sizeof(address);
+    memset(capture, 0, sizeof(*capture));
+    atomic_init(&capture->stopping, 0);
+    capture->listener = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    capture->active_client = TEST_INVALID_SOCKET;
+    assert(capture->listener != TEST_INVALID_SOCKET);
+    assert(pthread_mutex_init(&capture->mutex, NULL) == 0);
+    memset(&address, 0, sizeof(address));
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    address.sin_port = htons(0);
+    assert(bind(capture->listener, (struct sockaddr *)&address, sizeof(address)) == 0);
+    assert(getsockname(capture->listener, (struct sockaddr *)&address, &address_length) == 0);
+    capture->port = ntohs(address.sin_port);
+    assert(capture->port != 63932U);
+    assert(listen(capture->listener, MAX_CONNECTIONS) == 0);
+}
+
+static void capture_start(capture_t *capture) {
+    assert(pthread_create(&capture->thread, NULL, capture_main, capture) == 0);
+}
+
+static void capture_stop(capture_t *capture) {
+    atomic_store(&capture->stopping, 1);
+    test_close(capture->listener);
+    (void)capture_shutdown_active_client(capture);
+    pthread_join(capture->thread, NULL);
+    pthread_mutex_destroy(&capture->mutex);
+}
+
+static unsigned captured_media(capture_t *capture, unsigned connection) {
+    unsigned count = 0;
+    unsigned index;
+    pthread_mutex_lock(&capture->mutex);
+    if (connection >= capture->connection_count) {
+        pthread_mutex_unlock(&capture->mutex);
+        return 0;
+    }
+    for (index = 0; index < capture->connections[connection].frame_count; ++index) {
+        if (capture->connections[connection].frames[index].stream == 1) count++;
+    }
+    pthread_mutex_unlock(&capture->mutex);
+    return count;
+}
+
+static int captured_stalled_payload(capture_t *capture) {
+    int stalled;
+    pthread_mutex_lock(&capture->mutex);
+    stalled = capture->stalled_payload;
+    pthread_mutex_unlock(&capture->mutex);
+    return stalled;
+}
+
+static int wait_for_stalled_payload(capture_t *capture) {
+    unsigned attempt;
+    for (attempt = 0; attempt < 200; ++attempt) {
+        if (captured_stalled_payload(capture)) return 1;
+        sleep_ms(10);
+    }
+    return 0;
+}
+
+static int wait_for_captured_frames(capture_t *capture, unsigned connection,
+                                    unsigned expected) {
+    unsigned attempt;
+    for (attempt = 0; attempt < 200; ++attempt) {
+        unsigned count = 0;
+        pthread_mutex_lock(&capture->mutex);
+        if (connection < capture->connection_count)
+            count = capture->connections[connection].frame_count;
+        pthread_mutex_unlock(&capture->mutex);
+        if (count >= expected) return 1;
+        sleep_ms(10);
+    }
+    return 0;
+}
+
+static int wait_for_media(capture_t *capture, unsigned connection, unsigned expected) {
+    unsigned attempt;
+    for (attempt = 0; attempt < 200; ++attempt) {
+        if (captured_media(capture, connection) >= expected) return 1;
+        sleep_ms(10);
+    }
+    return 0;
+}
+
+static int wait_for_connections(capture_t *capture, unsigned expected) {
+    unsigned attempt;
+    for (attempt = 0; attempt < 200; ++attempt) {
+        unsigned count;
+        pthread_mutex_lock(&capture->mutex);
+        count = capture->connection_count;
+        pthread_mutex_unlock(&capture->mutex);
+        if (count >= expected) return 1;
+        sleep_ms(10);
+    }
+    return 0;
+}
+
+static unsigned connection_count_now(capture_t *capture) {
+    unsigned count;
+    pthread_mutex_lock(&capture->mutex);
+    count = capture->connection_count;
+    pthread_mutex_unlock(&capture->mutex);
+    return count;
+}
+
+static int capture_copy_connection(capture_t *capture, unsigned connection,
+                                    captured_connection_t *snapshot) {
+    int present = 0;
+    if (snapshot == NULL) return 0;
+    pthread_mutex_lock(&capture->mutex);
+    if (connection < capture->connection_count) {
+        *snapshot = capture->connections[connection];
+        present = 1;
+    }
+    pthread_mutex_unlock(&capture->mutex);
+    return present;
+}
+
+static int wait_for_connected_consumers(source_clock_renderer_t *renderer,
+                                        uint64_t expected) {
+    source_clock_metrics_snapshot_t snapshot;
+    unsigned attempt;
+    for (attempt = 0; attempt < 200; ++attempt) {
+        if (source_clock_renderer_metrics_snapshot(
+                renderer, source_clock_metrics_monotonic_time_ns(), &snapshot) &&
+            snapshot.connected_consumers >= expected)
+            return 1;
+        sleep_ms(10);
+    }
+    return 0;
+}
+
+static int wait_for_connected_consumers_exact(source_clock_renderer_t *renderer,
+                                              uint64_t expected) {
+    source_clock_metrics_snapshot_t snapshot;
+    unsigned attempt;
+    for (attempt = 0; attempt < 200; ++attempt) {
+        if (source_clock_renderer_metrics_snapshot(
+                renderer, source_clock_metrics_monotonic_time_ns(), &snapshot) &&
+            snapshot.connected_consumers == expected)
+            return 1;
+        sleep_ms(10);
+    }
+    return 0;
+}
