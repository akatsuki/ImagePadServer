+static void test_receiver_bootstrap_order_and_watermark(void) {
+    const char *token = "00112233445566778899aabbccddeeff";
+    char video_endpoint[64];
+    unsigned char sps[32], pps[32], idr[32], old_idr_nal[32], old_idr[64], frame[128];
+    unsigned char old_p[8];
+    size_t sps_size = make_sps(sps, 2);
+    size_t pps_size = make_pps(pps, 3, 2);
+    size_t idr_size = make_idr(idr, 3);
+    size_t old_idr_nal_size = make_idr(old_idr_nal, 1);
+    size_t frame_size;
+    capture_t capture;
+    source_clock_renderer_t *renderer;
+    source_clock_metrics_snapshot_t metrics;
+    capture_init(&capture);
+    snprintf(video_endpoint, sizeof(video_endpoint), "127.0.0.1:%u", capture.port);
+    renderer = source_clock_renderer_create(video_endpoint, "127.0.0.1:1", token,
+                                            "receiver-b2-test");
+    assert(renderer != NULL);
+    source_clock_renderer_session_start(renderer);
+    frame_size = annexb_one(old_idr, old_idr_nal, old_idr_nal_size);
+    assert(source_clock_renderer_push_video(renderer, old_idr, frame_size, 1, 0));
+    old_p[0] = 0;
+    old_p[1] = 0;
+    old_p[2] = 0;
+    old_p[3] = 1;
+    old_p[4] = 0x41;
+    old_p[5] = 0x80;
+    assert(source_clock_renderer_push_video(renderer, old_p, sizeof(old_p), 2, 0));
+    capture_start(&capture);
+    assert(wait_for_connections(&capture, 1));
+    assert(wait_for_connected_consumers(renderer, 1));
+    assert(wait_for_connected_consumers_exact(renderer, 1));
+    frame_size = annexb_one(frame, sps, sps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 3, 0));
+    frame_size = annexb_one(frame, pps, pps_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 4, 0));
+    frame_size = annexb_one(frame, idr, idr_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 5, 0));
+    frame_size = make_p_frame(frame);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 6, 0));
+    assert(wait_for_media(&capture, 0, 3));
+    assert(source_clock_renderer_metrics_snapshot(renderer, 1000000000ULL, &metrics));
+    assert(metrics.video_frames == 6);
+    source_clock_renderer_destroy(renderer);
+    capture_stop(&capture);
+    assert(capture.connection_count >= 1);
+    {
+        captured_connection_t *connection = &capture.connections[0];
+        unsigned index;
+        unsigned media_index = 0;
+        captured_frame_t *media[8];
+        for (index = 0; index < connection->frame_count; ++index) {
+            if (connection->frames[index].stream == 1 && media_index < 8)
+                media[media_index++] = &connection->frames[index];
+        }
+        assert(media_index >= 3);
+        assert((media[0]->flags & SOURCE_CLOCK_FLAG_CONFIG) != 0);
+        assert(contains_bytes(media[0]->data, media[0]->size, sps, sps_size));
+        assert(contains_bytes(media[0]->data, media[0]->size, pps, pps_size));
+        assert(media[0]->size > 4 + sps_size);
+        assert(media[1]->size == idr_size + 4);
+        assert(memcmp(media[1]->data + 4, idr, idr_size) == 0);
+        assert(media[2]->size == frame_size);
+        assert(memcmp(media[2]->data, frame, frame_size) == 0);
+        for (index = 0; index < media_index; ++index) {
+            assert(media[index]->size != old_idr_nal_size + 4 ||
+                   memcmp(media[index]->data + 4, old_idr_nal, old_idr_nal_size) != 0);
+        }
+    }
+}
