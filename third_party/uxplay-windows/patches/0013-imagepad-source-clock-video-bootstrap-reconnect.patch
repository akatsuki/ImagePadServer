+static void test_partial_bootstrap_disconnect_restarts_from_new_idr(void) {
+    const char *token = "00112233445566778899aabbccddeeff";
+    char video_endpoint[64];
+    unsigned char sps0[32], pps0[32], idr0[32];
+    unsigned char sps1[32], pps1[32], idr1[32];
+    unsigned char frame[128];
+    unsigned char p_frame[] = {0, 0, 0, 1, 0x41, 0x80};
+    size_t sps0_size = make_sps(sps0, 0);
+    size_t pps0_size = make_pps(pps0, 0, 0);
+    size_t idr0_size = make_idr(idr0, 0);
+    size_t sps1_size = make_sps(sps1, 4);
+    size_t pps1_size = make_pps(pps1, 5, 4);
+    size_t idr1_size = make_idr(idr1, 5);
+    size_t frame_size;
+    unsigned attempt;
+    capture_t capture;
+    source_clock_renderer_t *renderer;
+    source_clock_metrics_snapshot_t before_wait;
+    source_clock_metrics_snapshot_t after_wait;
+
+    capture_init(&capture);
+    capture.disconnect_first_payload_after_bytes = 1;
+    capture_start(&capture);
+    snprintf(video_endpoint, sizeof(video_endpoint), "127.0.0.1:%u", capture.port);
+    renderer = source_clock_renderer_create(video_endpoint, "127.0.0.1:1", token,
+                                            "receiver-b2-reconnect");
+    assert(renderer != NULL);
+    source_clock_renderer_session_start(renderer);
+    assert(wait_for_connections(&capture, 1));
+    assert(wait_for_connected_consumers(renderer, 1));
+    assert(wait_for_connected_consumers_exact(renderer, 1));
+    frame_size = annexb_one(frame, sps0, sps0_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 10, 0));
+    frame_size = annexb_one(frame, pps0, pps0_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 11, 0));
+    frame_size = annexb_one(frame, idr0, idr0_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 12, 0));
+    assert(wait_for_media(&capture, 0, 1));
+    for (attempt = 0; attempt < 100 && connection_count_now(&capture) < 2; ++attempt) {
+        assert(source_clock_renderer_push_video(renderer, p_frame, sizeof(p_frame),
+                                                13U + attempt, 0));
+        sleep_ms(20);
+    }
+    assert(wait_for_connections(&capture, 2));
+    assert(wait_for_connected_consumers(renderer, 1));
+    assert(wait_for_connected_consumers_exact(renderer, 1));
+    assert(source_clock_renderer_push_video(renderer, p_frame, sizeof(p_frame), 200, 0));
+    sleep_ms(100);
+    assert(captured_media(&capture, 1) == 0);
+    frame_size = annexb_one(frame, sps1, sps1_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 201, 0));
+    frame_size = annexb_one(frame, pps1, pps1_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 202, 0));
+    assert(source_clock_renderer_push_video(renderer, p_frame, sizeof(p_frame), 203, 0));
+    frame_size = annexb_one(frame, idr1, idr1_size);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 204, 0));
+    frame_size = make_p_frame(frame);
+    assert(source_clock_renderer_push_video(renderer, frame, frame_size, 205, 0));
+    assert(source_clock_renderer_metrics_snapshot(renderer, 1000000000ULL, &before_wait));
+    assert(wait_for_media(&capture, 1, 3));
+    sleep_ms(100);
+    assert(source_clock_renderer_metrics_snapshot(renderer, 1000000000ULL, &after_wait));
+    assert(after_wait.video_frames == before_wait.video_frames);
+    assert(after_wait.dropped_frames > 0);
+    assert(source_clock_renderer_video_dropped(renderer) > 0);
+    source_clock_renderer_destroy(renderer);
+    capture_stop(&capture);
+    assert(capture.connections[0].frame_count >= 3);
+    {
+        captured_connection_t *connection = &capture.connections[0];
+        unsigned index;
+        int saw_partial_bootstrap = 0;
+        for (index = 0; index < connection->frame_count; ++index) {
+            captured_frame_t *captured = &connection->frames[index];
+            if (captured->stream == 1U &&
+                (captured->flags & SOURCE_CLOCK_FLAG_CONFIG) != 0 &&
+                captured->size == 1U) {
+                saw_partial_bootstrap = 1;
+            }
+        }
+        assert(saw_partial_bootstrap);
+    }
+    {
+        captured_connection_t *connection = &capture.connections[1];
+        captured_frame_t *media[8];
+        unsigned index;
+        unsigned media_index = 0;
+        for (index = 0; index < connection->frame_count; ++index) {
+            if (connection->frames[index].stream == 1 && media_index < 8)
+                media[media_index++] = &connection->frames[index];
+        }
+        assert(media_index == 3);
+        assert((media[0]->flags & SOURCE_CLOCK_FLAG_CONFIG) != 0);
+        assert(contains_bytes(media[0]->data, media[0]->size, sps1, sps1_size));
+        assert(contains_bytes(media[0]->data, media[0]->size, pps1, pps1_size));
+        assert(media[1]->size == idr1_size + 4U);
+        assert(memcmp(media[1]->data + 4U, idr1, idr1_size) == 0);
+        assert(media[2]->size == 6U && media[2]->data[4] == 0x41U);
+    }
+}
