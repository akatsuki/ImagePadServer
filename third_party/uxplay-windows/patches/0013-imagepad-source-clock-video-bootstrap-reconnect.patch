+static bool send_video_bootstrap_config(source_clock_writer_t *writer,
+                                        SOURCE_CLOCK_SOCKET socket_fd,
+                                        const source_clock_frame_t *reference,
+                                        const source_clock_video_bootstrap_snapshot_t *snapshot,
+                                        int *socket_error) {
+    source_clock_frame_t config;
+    size_t payload_size;
+    unsigned char *payload;
+    if (writer == NULL || reference == NULL || snapshot == NULL ||
+        snapshot->sps == NULL || snapshot->pps == NULL ||
+        snapshot->pps_size > SIZE_MAX - 8U ||
+        snapshot->sps_size > SIZE_MAX - 8U - snapshot->pps_size)
+        return false;
+    payload_size = 4U + snapshot->sps_size + 4U + snapshot->pps_size;
+    if (payload_size > SOURCE_CLOCK_MAX_VIDEO_PAYLOAD) return false;
+    payload = (unsigned char *)malloc(payload_size);
+    if (payload == NULL) return false;
+    memset(payload, 0, 4U);
+    payload[3] = 1U;
+    memcpy(payload + 4U, snapshot->sps, snapshot->sps_size);
+    memset(payload + 4U + snapshot->sps_size, 0, 4U);
+    payload[4U + snapshot->sps_size + 3U] = 1U;
+    memcpy(payload + 8U + snapshot->sps_size, snapshot->pps, snapshot->pps_size);
+    memset(&config, 0, sizeof(config));
+    config.data = payload;
+    config.len = payload_size;
+    config.ntp_ns = reference->ntp_ns;
+    config.sequence = reference->sequence;
+    config.codec = reference->codec;
+    config.flags = SOURCE_CLOCK_FLAG_CONFIG | SOURCE_CLOCK_FLAG_DISCONTINUITY;
+    if (!send_frame(writer, socket_fd, &config, socket_error)) {
+        free(payload);
+        return false;
+    }
+    free(payload);
+    return true;
+}
