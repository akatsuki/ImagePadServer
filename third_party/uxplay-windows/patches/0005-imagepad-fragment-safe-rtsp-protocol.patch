diff --git a/lib/tests/http_request_fragmentation_test.c b/lib/tests/http_request_fragmentation_test.c
new file mode 100644
--- /dev/null
+++ b/lib/tests/http_request_fragmentation_test.c
@@ -0,0 +1,50 @@
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "../http_request.h"
+
+static int check_fragment_size(size_t fragment_size) {
+    static const char request_text[] =
+        "GET /info RTSP/1.0\r\n"
+        "CSeq: 0\r\n"
+        "Content-Length: 0\r\n"
+        "\r\n";
+    const size_t request_length = sizeof(request_text) - 1;
+    http_request_t *request = http_request_init();
+    if (request == NULL) return 1;
+
+    for (size_t offset = 0; offset < request_length;) {
+        size_t length = fragment_size;
+        if (length > request_length - offset) length = request_length - offset;
+        uint8_t fragment[64];
+        memset(fragment, 0xa5, sizeof(fragment));
+        memcpy(fragment, request_text + offset, length);
+        if (http_request_add_data(request, (const char *)fragment, (int)length) != 0) {
+            http_request_destroy(request);
+            return 2;
+        }
+        offset += length;
+    }
+
+    int result = 0;
+    if (!http_request_is_complete(request)) result = 3;
+    else if (strcmp(http_request_get_method(request), "GET") != 0) result = 4;
+    else if (strcmp(http_request_get_url(request), "/info") != 0) result = 5;
+    else if (strcmp(http_request_get_protocol(request), "RTSP/1.0") != 0) result = 6;
+    http_request_destroy(request);
+    return result;
+}
+
+int main(void) {
+    static const size_t fragment_sizes[] = {1, 2, 7, 39, 40, 41};
+    for (size_t i = 0; i < sizeof(fragment_sizes) / sizeof(fragment_sizes[0]); i++) {
+        int result = check_fragment_size(fragment_sizes[i]);
+        if (result != 0) {
+            fprintf(stderr, "fragment_size=%zu result=%d\n", fragment_sizes[i], result);
+            return result;
+        }
+    }
+    return 0;
+}
