+static int
+on_protocol(llhttp_t *parser, const char *at, size_t length)
+{
+    http_request_t *request = parser->data;
+    size_t protocol_length = strlen(request->protocol);
+
+    if (length > sizeof(request->protocol) - protocol_length - 1) {
+        return HPE_USER;
+    }
+    memcpy(request->protocol + protocol_length, at, length);
+    request->protocol[protocol_length + length] = '\0';
+    return 0;
+}
+
+static int
+on_version(llhttp_t *parser, const char *at, size_t length)
+{
+    http_request_t *request = parser->data;
+    size_t protocol_length = strlen(request->protocol);
+
+    if (!request->protocol_version_started) {
+        if (protocol_length + 1 >= sizeof(request->protocol)) return HPE_USER;
+        request->protocol[protocol_length++] = '/';
+        request->protocol[protocol_length] = '\0';
+        request->protocol_version_started = true;
+    }
+    if (length > sizeof(request->protocol) - protocol_length - 1) {
+        return HPE_USER;
+    }
+    memcpy(request->protocol + protocol_length, at, length);
+    request->protocol[protocol_length + length] = '\0';
+    return 0;
+}
