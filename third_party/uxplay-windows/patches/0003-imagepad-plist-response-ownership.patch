diff --git a/lib/raop.c b/lib/raop.c
--- a/lib/raop.c
+++ b/lib/raop.c
@@ -18,3 +18,5 @@
 #include <stdio.h>
 #include <string.h>
 #include <assert.h>
+#include <limits.h>
+#include <plist/plist.h>
@@ -42,2 +42,40 @@ static void plist_mem_free(void *ptr) {
 }
 #endif
+/*
+ * libplist 2.3 allocates plist_to_xml/plist_to_bin output with its own
+ * allocator. HTTP handlers hand response_data to conn_request, which owns
+ * it with plain free(). Copy the serialized plist into a normal malloc
+ * buffer at the boundary so every response_data path has one owner.
+ */
+static int
+plist_to_malloc_response(plist_t plist, char **response_data,
+                          int *response_datalen, int binary) {
+    char *plist_data = NULL;
+    uint32_t plist_datalen = 0;
+    plist_err_t err;
+
+    if (!response_data || !response_datalen) {
+        return 0;
+    }
+    *response_data = NULL;
+    *response_datalen = 0;
+
+    err = binary ? plist_to_bin(plist, &plist_data, &plist_datalen)
+                 : plist_to_xml(plist, &plist_data, &plist_datalen);
+    if (err != PLIST_ERR_SUCCESS || !plist_data || plist_datalen > INT_MAX) {
+        if (plist_data) {
+            plist_mem_free(plist_data);
+        }
+        return 0;
+    }
+    *response_data = malloc((size_t) plist_datalen + 1);
+    if (!*response_data) {
+        plist_mem_free(plist_data);
+        return 0;
+    }
+    memcpy(*response_data, plist_data, plist_datalen);
+    (*response_data)[plist_datalen] = '\0';
+    *response_datalen = (int) plist_datalen;
+    plist_mem_free(plist_data);
+    return 1;
+}
