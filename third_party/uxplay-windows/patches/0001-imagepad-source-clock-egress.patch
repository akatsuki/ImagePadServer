diff --git a/renderers/source_clock_renderer_test.c b/renderers/source_clock_renderer_test.c
new file mode 100644
index 0000000..5c4094f
--- /dev/null
+++ b/renderers/source_clock_renderer_test.c
@@ -0,0 +1,140 @@
+#include "source_clock_renderer.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#include <pthread.h>
+#define TEST_SOCKET SOCKET
+#define TEST_INVALID_SOCKET INVALID_SOCKET
+#define test_close closesocket
+#else
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <pthread.h>
+#define TEST_SOCKET int
+#define TEST_INVALID_SOCKET (-1)
+#define test_close close
+#endif
+
+typedef struct test_server_s {
+    TEST_SOCKET listener;
+    unsigned port;
+    unsigned stream_kind;
+    int hello;
+    int session_start;
+    int media;
+} test_server_t;
+
+static unsigned read_u32(const unsigned char *p) {
+    return ((unsigned)p[0] << 24) | ((unsigned)p[1] << 16) |
+           ((unsigned)p[2] << 8) | (unsigned)p[3];
+}
+
+static int read_full(TEST_SOCKET socket_fd, unsigned char *data, size_t length) {
+    while (length > 0) {
+        int received = recv(socket_fd, (char *)data, (int)length, 0);
+        if (received <= 0) return 0;
+        data += received;
+        length -= (size_t)received;
+    }
+    return 1;
+}
+
+static void *server_main(void *argument) {
+    test_server_t *server = (test_server_t *)argument;
+    TEST_SOCKET client = accept(server->listener, NULL, NULL);
+    unsigned char header[40];
+    if (client == TEST_INVALID_SOCKET) return NULL;
+    while (read_full(client, header, sizeof(header))) {
+        unsigned payload_bytes;
+        if (memcmp(header, "IPAF", 4) != 0 ||
+            (header[8] != 0 && header[8] != server->stream_kind)) break;
+        payload_bytes = read_u32(header + 12);
+        if (header[8] == 0 && header[9] == 1) server->hello = 1;
+        if (header[8] == 0 && header[9] == 2) server->session_start = 1;
+        if (header[8] == server->stream_kind && server->stream_kind != 0) server->media = 1;
+        while (payload_bytes > 0) {
+            unsigned char discard[1024];
+            size_t take = payload_bytes < sizeof(discard) ? payload_bytes : sizeof(discard);
+            if (!read_full(client, discard, take)) {
+                test_close(client);
+                return NULL;
+            }
+            payload_bytes -= (unsigned)take;
+        }
+        if (server->hello && server->session_start && server->media) break;
+    }
+    test_close(client);
+    return NULL;
+}
+
+static void init_server(test_server_t *server, unsigned stream_kind) {
+    struct sockaddr_in address;
+    int address_length = sizeof(address);
+    memset(server, 0, sizeof(*server));
+    server->stream_kind = stream_kind;
+    server->listener = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    assert(server->listener != TEST_INVALID_SOCKET);
+    memset(&address, 0, sizeof(address));
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    address.sin_port = htons(0);
+    assert(bind(server->listener, (struct sockaddr *)&address, sizeof(address)) == 0);
+    assert(listen(server->listener, 1) == 0);
+    assert(getsockname(server->listener, (struct sockaddr *)&address, &address_length) == 0);
+    server->port = ntohs(address.sin_port);
+}
+
+int main(void) {
+    const char *token = "00112233445566778899aabbccddeeff";
+    char video_endpoint[64];
+    char audio_endpoint[64];
+    unsigned char video[] = { 0, 0, 0, 1, 0x65, 0x88 };
+    unsigned char audio[] = { 0x8c, 0x01, 0x02, 0x03 };
+    test_server_t video_server;
+    test_server_t audio_server;
+    pthread_t video_thread;
+    pthread_t audio_thread;
+    source_clock_renderer_t *renderer;
+#ifdef _WIN32
+    WSADATA wsa;
+    assert(WSAStartup(MAKEWORD(2, 2), &wsa) == 0);
+#endif
+    init_server(&video_server, 1);
+    init_server(&audio_server, 2);
+    snprintf(video_endpoint, sizeof(video_endpoint), "127.0.0.1:%u", video_server.port);
+    snprintf(audio_endpoint, sizeof(audio_endpoint), "127.0.0.1:%u", audio_server.port);
+    assert(pthread_create(&video_thread, NULL, server_main, &video_server) == 0);
+    assert(pthread_create(&audio_thread, NULL, server_main, &audio_server) == 0);
+    renderer = source_clock_renderer_create(video_endpoint, audio_endpoint, token);
+    assert(renderer != NULL);
+    source_clock_renderer_session_start(renderer);
+    assert(!source_clock_renderer_push_video(renderer, NULL, 4, 0, 0));
+    assert(!source_clock_renderer_push_audio(renderer, NULL, 4, 0, 0));
+    assert(source_clock_renderer_push_video(renderer, video, sizeof(video), 1000000000ULL, 0));
+    assert(source_clock_renderer_push_audio(renderer, audio, sizeof(audio), 1000000000ULL, 0));
+#ifdef _WIN32
+    Sleep(300);
+#else
+    usleep(300000);
+#endif
+    source_clock_renderer_destroy(renderer);
+    test_close(video_server.listener);
+    test_close(audio_server.listener);
+    pthread_join(video_thread, NULL);
+    pthread_join(audio_thread, NULL);
+    assert(video_server.hello && video_server.session_start && video_server.media);
+    assert(audio_server.hello && audio_server.session_start && audio_server.media);
+#ifdef _WIN32
+    WSACleanup();
+#endif
+    puts("source_clock_renderer: PASS");
+    return 0;
+}
