diff --git a/renderers/source_clock_renderer.c b/renderers/source_clock_renderer.c
new file mode 100644
index 0000000..8dfb47a
--- /dev/null
+++ b/renderers/source_clock_renderer.c
@@ -0,0 +1,637 @@
+#include "source_clock_renderer.h"
+
+#include <ctype.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <time.h>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#define SOURCE_CLOCK_SOCKET SOCKET
+#define SOURCE_CLOCK_INVALID_SOCKET INVALID_SOCKET
+#define source_clock_close_socket closesocket
+#else
+#include <netdb.h>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#define SOURCE_CLOCK_SOCKET int
+#define SOURCE_CLOCK_INVALID_SOCKET (-1)
+#define source_clock_close_socket close
+#endif
+
+#include "../lib/threads.h"
+
+#define SOURCE_CLOCK_PROTOCOL_VERSION 1u
+#define SOURCE_CLOCK_HEADER_SIZE 40u
+#define SOURCE_CLOCK_MAX_VIDEO_PAYLOAD (64u * 1024u * 1024u)
+#define SOURCE_CLOCK_MAX_AUDIO_PAYLOAD (1u * 1024u * 1024u)
+#define SOURCE_CLOCK_TOKEN_BYTES 16u
+#define SOURCE_CLOCK_STREAM_VIDEO 1u
+#define SOURCE_CLOCK_STREAM_AUDIO 2u
+#define SOURCE_CLOCK_STREAM_CONTROL 0u
+#define SOURCE_CLOCK_CONTROL_HELLO 1u
+#define SOURCE_CLOCK_CONTROL_SESSION_START 2u
+#define SOURCE_CLOCK_CONTROL_SESSION_END 4u
+#define SOURCE_CLOCK_VIDEO_QUEUE_FRAMES 3u
+#define SOURCE_CLOCK_AUDIO_QUEUE_NS 500000000ULL
+#define SOURCE_CLOCK_RETRY_NS 250000000ULL
+
+typedef struct source_clock_frame_s {
+    struct source_clock_frame_s *next;
+    unsigned char *data;
+    size_t len;
+    uint64_t ntp_ns;
+    uint32_t sequence;
+    uint32_t sample_count;
+    uint32_t sample_rate;
+    uint16_t channels;
+    uint8_t codec;
+    uint16_t flags;
+    uint64_t duration_ns;
+} source_clock_frame_t;
+
+typedef struct source_clock_writer_s source_clock_writer_t;
+
+struct source_clock_writer_s {
+    source_clock_renderer_t *owner;
+    uint8_t stream_kind;
+    char *endpoint;
+    uint8_t token[SOURCE_CLOCK_TOKEN_BYTES];
+    pthread_t thread;
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    bool stopping;
+    bool session_active;
+    bool send_session_end;
+    bool discontinuity_pending;
+    uint32_t generation;
+    uint32_t sequence;
+    source_clock_frame_t *head;
+    source_clock_frame_t *tail;
+    size_t pending_count;
+    size_t pending_bytes;
+    uint64_t pending_ns;
+    uint64_t dropped;
+    bool thread_started;
+};
+
+struct source_clock_renderer_s {
+    source_clock_writer_t video;
+    source_clock_writer_t audio;
+    uint8_t video_codec;
+    uint8_t audio_codec;
+    uint32_t audio_sample_rate;
+    uint16_t audio_channels;
+    uint16_t audio_spf;
+    bool started;
+};
+
+static void sleep_retry(void) {
+#ifdef _WIN32
+    Sleep((DWORD)(SOURCE_CLOCK_RETRY_NS / 1000000ULL));
+#else
+    struct timespec ts = { 0, SOURCE_CLOCK_RETRY_NS };
+    nanosleep(&ts, NULL);
+#endif
+}
+
+static char *copy_string(const char *value) {
+    size_t length;
+    char *copy;
+    if (value == NULL) return NULL;
+    length = strlen(value);
+    copy = (char *)malloc(length + 1);
+    if (copy != NULL) memcpy(copy, value, length + 1);
+    return copy;
+}
+
+static int hex_value(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static bool decode_token(const char *hex, uint8_t token[SOURCE_CLOCK_TOKEN_BYTES]) {
+    size_t i;
+    if (hex == NULL || strlen(hex) != SOURCE_CLOCK_TOKEN_BYTES * 2) return false;
+    for (i = 0; i < SOURCE_CLOCK_TOKEN_BYTES; ++i) {
+        int high = hex_value(hex[i * 2]);
+        int low = hex_value(hex[i * 2 + 1]);
+        if (high < 0 || low < 0) return false;
+        token[i] = (uint8_t)((high << 4) | low);
+    }
+    return true;
+}
+
+static void put_u16(uint8_t *out, uint16_t value) {
+    out[0] = (uint8_t)(value >> 8);
+    out[1] = (uint8_t)value;
+}
+
+static void put_u32(uint8_t *out, uint32_t value) {
+    out[0] = (uint8_t)(value >> 24);
+    out[1] = (uint8_t)(value >> 16);
+    out[2] = (uint8_t)(value >> 8);
+    out[3] = (uint8_t)value;
+}
+
+static void put_u64(uint8_t *out, uint64_t value) {
+    put_u32(out, (uint32_t)(value >> 32));
+    put_u32(out + 4, (uint32_t)value);
+}
+
+static void encode_header(uint8_t out[SOURCE_CLOCK_HEADER_SIZE], uint8_t stream_kind,
+                          uint8_t codec, uint16_t flags, uint32_t payload_bytes,
+                          uint32_t sequence, uint64_t ntp_ns, uint32_t sample_count,
+                          uint32_t sample_rate, uint16_t channels) {
+    memset(out, 0, SOURCE_CLOCK_HEADER_SIZE);
+    memcpy(out, "IPAF", 4);
+    put_u16(out + 4, SOURCE_CLOCK_PROTOCOL_VERSION);
+    put_u16(out + 6, SOURCE_CLOCK_HEADER_SIZE);
+    out[8] = stream_kind;
+    out[9] = codec;
+    put_u16(out + 10, flags);
+    put_u32(out + 12, payload_bytes);
+    put_u32(out + 16, sequence);
+    put_u64(out + 20, ntp_ns);
+    put_u32(out + 28, sample_count);
+    put_u32(out + 32, sample_rate);
+    put_u16(out + 36, channels);
+}
+
+static bool send_all(SOURCE_CLOCK_SOCKET socket_fd, const void *data, size_t length) {
+    const unsigned char *bytes = (const unsigned char *)data;
+    while (length > 0) {
+        int sent = send(socket_fd, (const char *)bytes,
+                        (int)(length > 1024 * 1024 ? 1024 * 1024 : length), 0);
+        if (sent <= 0) return false;
+        bytes += sent;
+        length -= (size_t)sent;
+    }
+    return true;
+}
+
+static bool send_control(source_clock_writer_t *writer, SOURCE_CLOCK_SOCKET socket_fd,
+                         uint8_t opcode, uint32_t generation) {
+    uint8_t header[SOURCE_CLOCK_HEADER_SIZE];
+    uint8_t payload[SOURCE_CLOCK_TOKEN_BYTES];
+    const uint8_t *body = NULL;
+    uint32_t body_len = 0;
+    if (opcode == SOURCE_CLOCK_CONTROL_HELLO) {
+        memcpy(payload, writer->token, sizeof(payload));
+        body = payload;
+        body_len = sizeof(payload);
+    }
+    encode_header(header, SOURCE_CLOCK_STREAM_CONTROL, opcode, 0, body_len,
+                  generation, 0, 0, 0, 0);
+    if (!send_all(socket_fd, header, sizeof(header))) return false;
+    return body_len == 0 || send_all(socket_fd, body, body_len);
+}
+
+static SOURCE_CLOCK_SOCKET connect_endpoint(const char *endpoint) {
+    char *separator;
+    char *host;
+    char *port;
+    struct addrinfo hints;
+    struct addrinfo *result = NULL;
+    struct addrinfo *entry;
+    SOURCE_CLOCK_SOCKET socket_fd = SOURCE_CLOCK_INVALID_SOCKET;
+    if (endpoint == NULL) return SOURCE_CLOCK_INVALID_SOCKET;
+    host = copy_string(endpoint);
+    if (host == NULL) return SOURCE_CLOCK_INVALID_SOCKET;
+    separator = strrchr(host, ':');
+    if (separator == NULL) {
+        free(host);
+        return SOURCE_CLOCK_INVALID_SOCKET;
+    }
+    *separator = '\0';
+    port = separator + 1;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    if (getaddrinfo(host, port, &hints, &result) != 0) {
+        free(host);
+        return SOURCE_CLOCK_INVALID_SOCKET;
+    }
+    for (entry = result; entry != NULL; entry = entry->ai_next) {
+        socket_fd = (SOURCE_CLOCK_SOCKET)socket(entry->ai_family, entry->ai_socktype,
+                                                entry->ai_protocol);
+        if (socket_fd == SOURCE_CLOCK_INVALID_SOCKET) continue;
+        if (connect(socket_fd, entry->ai_addr, (int)entry->ai_addrlen) == 0) break;
+        source_clock_close_socket(socket_fd);
+        socket_fd = SOURCE_CLOCK_INVALID_SOCKET;
+    }
+    freeaddrinfo(result);
+    free(host);
+    return socket_fd;
+}
+
+static void free_frame(source_clock_frame_t *frame) {
+    if (frame == NULL) return;
+    free(frame->data);
+    free(frame);
+}
+
+static source_clock_frame_t *pop_frame(source_clock_writer_t *writer) {
+    source_clock_frame_t *frame = writer->head;
+    if (frame == NULL) return NULL;
+    writer->head = frame->next;
+    if (writer->head == NULL) writer->tail = NULL;
+    writer->pending_count--;
+    writer->pending_bytes -= frame->len;
+    writer->pending_ns -= frame->duration_ns;
+    frame->next = NULL;
+    return frame;
+}
+
+static void drop_oldest(source_clock_writer_t *writer) {
+    source_clock_frame_t *frame = pop_frame(writer);
+    if (frame != NULL) {
+        writer->dropped++;
+        writer->discontinuity_pending = true;
+        free_frame(frame);
+    }
+}
+
+static void clear_pending(source_clock_writer_t *writer) {
+    source_clock_frame_t *frame;
+    while ((frame = pop_frame(writer)) != NULL) {
+        free_frame(frame);
+    }
+    writer->discontinuity_pending = false;
+}
+
+static bool send_frame(source_clock_writer_t *writer, SOURCE_CLOCK_SOCKET socket_fd,
+                       source_clock_frame_t *frame) {
+    uint8_t header[SOURCE_CLOCK_HEADER_SIZE];
+    uint16_t flags = frame->flags;
+    encode_header(header, writer->stream_kind, frame->codec, flags, (uint32_t)frame->len,
+                  frame->sequence, frame->ntp_ns, frame->sample_count,
+                  frame->sample_rate, frame->channels);
+    return send_all(socket_fd, header, sizeof(header)) && send_all(socket_fd, frame->data, frame->len);
+}
+
+static void close_socket_once(SOURCE_CLOCK_SOCKET *socket_fd) {
+    if (socket_fd == NULL || *socket_fd == SOURCE_CLOCK_INVALID_SOCKET) return;
+    source_clock_close_socket(*socket_fd);
+    *socket_fd = SOURCE_CLOCK_INVALID_SOCKET;
+}
+
+static void *writer_main(void *argument) {
+    source_clock_writer_t *writer = (source_clock_writer_t *)argument;
+    for (;;) {
+        SOURCE_CLOCK_SOCKET socket_fd;
+        source_clock_frame_t *frame;
+        bool active;
+        uint32_t generation;
+        bool send_end;
+        pthread_mutex_lock(&writer->mutex);
+        while (!writer->stopping && writer->head == NULL && !writer->send_session_end &&
+               !writer->session_active) {
+            pthread_cond_wait(&writer->cond, &writer->mutex);
+        }
+        if (writer->stopping) {
+            pthread_mutex_unlock(&writer->mutex);
+            break;
+        }
+        active = writer->session_active;
+        generation = writer->generation;
+        send_end = writer->send_session_end;
+        writer->send_session_end = false;
+        pthread_mutex_unlock(&writer->mutex);
+
+        socket_fd = connect_endpoint(writer->endpoint);
+        if (socket_fd == SOURCE_CLOCK_INVALID_SOCKET) {
+            sleep_retry();
+            continue;
+        }
+        if (!send_control(writer, socket_fd, SOURCE_CLOCK_CONTROL_HELLO, generation) ||
+            (active && !send_control(writer, socket_fd, SOURCE_CLOCK_CONTROL_SESSION_START, generation))) {
+            close_socket_once(&socket_fd);
+            sleep_retry();
+            continue;
+        }
+        if (send_end && !send_control(writer, socket_fd, SOURCE_CLOCK_CONTROL_SESSION_END, generation)) {
+            close_socket_once(&socket_fd);
+            sleep_retry();
+            continue;
+        }
+        for (;;) {
+            bool generation_changed;
+            bool end_requested;
+            pthread_mutex_lock(&writer->mutex);
+            if (writer->stopping) {
+                pthread_mutex_unlock(&writer->mutex);
+                close_socket_once(&socket_fd);
+                return NULL;
+            }
+            generation_changed = writer->generation != generation;
+            end_requested = writer->send_session_end || !writer->session_active;
+            if (writer->send_session_end) writer->send_session_end = false;
+            if (generation_changed || end_requested) {
+                pthread_mutex_unlock(&writer->mutex);
+                if (end_requested) {
+                    send_control(writer, socket_fd, SOURCE_CLOCK_CONTROL_SESSION_END, generation);
+                }
+                close_socket_once(&socket_fd);
+                break;
+            }
+            frame = pop_frame(writer);
+            if (frame != NULL && writer->discontinuity_pending) {
+                frame->flags |= SOURCE_CLOCK_FLAG_DISCONTINUITY;
+                writer->discontinuity_pending = false;
+            }
+            pthread_mutex_unlock(&writer->mutex);
+            if (frame == NULL) break;
+            if (!send_frame(writer, socket_fd, frame)) {
+                pthread_mutex_lock(&writer->mutex);
+                writer->discontinuity_pending = true;
+                pthread_mutex_unlock(&writer->mutex);
+                free_frame(frame);
+                close_socket_once(&socket_fd);
+                sleep_retry();
+                break;
+            }
+            free_frame(frame);
+        }
+        close_socket_once(&socket_fd);
+    }
+    return NULL;
+}
+
+static void writer_init(source_clock_writer_t *writer, source_clock_renderer_t *owner,
+                        uint8_t stream_kind, const char *endpoint, const uint8_t token[16]) {
+    memset(writer, 0, sizeof(*writer));
+    writer->owner = owner;
+    writer->stream_kind = stream_kind;
+    writer->endpoint = copy_string(endpoint);
+    memcpy(writer->token, token, SOURCE_CLOCK_TOKEN_BYTES);
+    pthread_mutex_init(&writer->mutex, NULL);
+    pthread_cond_init(&writer->cond, NULL);
+}
+
+static bool queue_frame(source_clock_writer_t *writer, const unsigned char *data, size_t data_len,
+                        uint64_t ntp_ns, uint8_t codec, uint16_t flags, uint32_t sample_count,
+                        uint32_t sample_rate, uint16_t channels, uint64_t duration_ns) {
+    source_clock_frame_t *frame;
+    if (writer == NULL || data == NULL || data_len == 0 ||
+        data_len > (writer->stream_kind == SOURCE_CLOCK_STREAM_VIDEO ?
+                    SOURCE_CLOCK_MAX_VIDEO_PAYLOAD : SOURCE_CLOCK_MAX_AUDIO_PAYLOAD)) {
+        return false;
+    }
+    frame = (source_clock_frame_t *)calloc(1, sizeof(*frame));
+    if (frame == NULL) return false;
+    frame->data = (unsigned char *)malloc(data_len);
+    if (frame->data == NULL) {
+        free(frame);
+        return false;
+    }
+    memcpy(frame->data, data, data_len);
+    frame->len = data_len;
+    frame->ntp_ns = ntp_ns;
+    frame->codec = codec;
+    frame->flags = flags;
+    frame->sample_count = sample_count;
+    frame->sample_rate = sample_rate;
+    frame->channels = channels;
+    frame->duration_ns = duration_ns;
+    pthread_mutex_lock(&writer->mutex);
+    if (writer->stopping) {
+        pthread_mutex_unlock(&writer->mutex);
+        free_frame(frame);
+        return false;
+    }
+    frame->sequence = ++writer->sequence;
+    if (writer->stream_kind == SOURCE_CLOCK_STREAM_VIDEO) {
+        while (writer->pending_count >= SOURCE_CLOCK_VIDEO_QUEUE_FRAMES ||
+               writer->pending_bytes + data_len > SOURCE_CLOCK_MAX_VIDEO_PAYLOAD) {
+            drop_oldest(writer);
+        }
+    } else {
+        while (writer->pending_ns + duration_ns > SOURCE_CLOCK_AUDIO_QUEUE_NS && writer->head != NULL) {
+            drop_oldest(writer);
+        }
+    }
+    if (writer->tail != NULL) writer->tail->next = frame;
+    else writer->head = frame;
+    writer->tail = frame;
+    writer->pending_count++;
+    writer->pending_bytes += data_len;
+    writer->pending_ns += duration_ns;
+    pthread_cond_signal(&writer->cond);
+    pthread_mutex_unlock(&writer->mutex);
+    return true;
+}
+
+source_clock_renderer_t *source_clock_renderer_create(const char *video_endpoint,
+                                                       const char *audio_endpoint,
+                                                       const char *token_hex) {
+    source_clock_renderer_t *renderer;
+    uint8_t token[SOURCE_CLOCK_TOKEN_BYTES];
+    if (!decode_token(token_hex, token) || video_endpoint == NULL || audio_endpoint == NULL) return NULL;
+    renderer = (source_clock_renderer_t *)calloc(1, sizeof(*renderer));
+    if (renderer == NULL) return NULL;
+    renderer->video_codec = SOURCE_CLOCK_VIDEO_H264;
+    renderer->audio_codec = SOURCE_CLOCK_AUDIO_AAC_ELD;
+    renderer->audio_sample_rate = 44100;
+    renderer->audio_channels = 2;
+    renderer->audio_spf = 480;
+    writer_init(&renderer->video, renderer, SOURCE_CLOCK_STREAM_VIDEO, video_endpoint, token);
+    writer_init(&renderer->audio, renderer, SOURCE_CLOCK_STREAM_AUDIO, audio_endpoint, token);
+    if (renderer->video.endpoint == NULL || renderer->audio.endpoint == NULL) {
+        source_clock_renderer_destroy(renderer);
+        return NULL;
+    }
+    if (pthread_create(&renderer->video.thread, NULL, writer_main, &renderer->video) != 0) {
+        source_clock_renderer_destroy(renderer);
+        return NULL;
+    }
+    renderer->video.thread_started = true;
+    if (pthread_create(&renderer->audio.thread, NULL, writer_main, &renderer->audio) != 0) {
+        source_clock_renderer_destroy(renderer);
+        return NULL;
+    }
+    renderer->audio.thread_started = true;
+    renderer->started = true;
+    return renderer;
+}
+
+void source_clock_renderer_destroy(source_clock_renderer_t *renderer) {
+    source_clock_writer_t *writers[2];
+    source_clock_frame_t *frame;
+    size_t i;
+    if (renderer == NULL) return;
+    writers[0] = &renderer->video;
+    writers[1] = &renderer->audio;
+    for (i = 0; i < 2; ++i) {
+        source_clock_writer_t *writer = writers[i];
+        pthread_mutex_lock(&writer->mutex);
+        writer->stopping = true;
+        pthread_cond_signal(&writer->cond);
+        pthread_mutex_unlock(&writer->mutex);
+    }
+    if (renderer->video.thread_started) {
+        pthread_join(renderer->video.thread, NULL);
+        renderer->video.thread_started = false;
+    }
+    if (renderer->audio.thread_started) {
+        pthread_join(renderer->audio.thread, NULL);
+        renderer->audio.thread_started = false;
+    }
+    for (i = 0; i < 2; ++i) {
+        source_clock_writer_t *writer = writers[i];
+        while ((frame = pop_frame(writer)) != NULL) free_frame(frame);
+        pthread_cond_destroy(&writer->cond);
+        pthread_mutex_destroy(&writer->mutex);
+        free(writer->endpoint);
+    }
+    free(renderer);
+}
+
+void source_clock_renderer_session_start(source_clock_renderer_t *renderer) {
+    source_clock_writer_t *writers[2];
+    size_t i;
+    if (renderer == NULL) return;
+    writers[0] = &renderer->video;
+    writers[1] = &renderer->audio;
+    for (i = 0; i < 2; ++i) {
+        pthread_mutex_lock(&writers[i]->mutex);
+        clear_pending(writers[i]);
+        writers[i]->generation++;
+        writers[i]->session_active = true;
+        writers[i]->send_session_end = false;
+        pthread_cond_signal(&writers[i]->cond);
+        pthread_mutex_unlock(&writers[i]->mutex);
+    }
+}
+
+void source_clock_renderer_session_end(source_clock_renderer_t *renderer) {
+    source_clock_writer_t *writers[2];
+    size_t i;
+    if (renderer == NULL) return;
+    writers[0] = &renderer->video;
+    writers[1] = &renderer->audio;
+    for (i = 0; i < 2; ++i) {
+        pthread_mutex_lock(&writers[i]->mutex);
+        clear_pending(writers[i]);
+        writers[i]->session_active = false;
+        writers[i]->send_session_end = true;
+        pthread_cond_signal(&writers[i]->cond);
+        pthread_mutex_unlock(&writers[i]->mutex);
+    }
+}
+
+void source_clock_renderer_set_video_codec(source_clock_renderer_t *renderer,
+                                           source_clock_video_codec_t codec) {
+    if (renderer != NULL) renderer->video_codec = (uint8_t)codec;
+}
+
+void source_clock_renderer_set_audio_format(source_clock_renderer_t *renderer,
+                                            unsigned char ct, unsigned short spf,
+                                            uint32_t sample_rate, uint16_t channels) {
+    if (renderer == NULL) return;
+    renderer->audio_codec = (ct == 2) ? SOURCE_CLOCK_AUDIO_ALAC :
+                            (ct == 8) ? SOURCE_CLOCK_AUDIO_AAC_ELD :
+                                        SOURCE_CLOCK_AUDIO_AAC_LC_ADTS;
+    renderer->audio_spf = spf != 0 ? spf : 480;
+    renderer->audio_sample_rate = sample_rate != 0 ? sample_rate : 44100;
+    renderer->audio_channels = channels != 0 ? channels : 2;
+}
+
+static unsigned scan_video_flags(const unsigned char *data, size_t len, uint8_t codec) {
+    size_t i;
+    unsigned flags = 0;
+    for (i = 0; i + 4 <= len; ++i) {
+        size_t start = i;
+        uint8_t type;
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+            start = i + 3;
+        } else if (i + 4 <= len && data[i] == 0 && data[i + 1] == 0 &&
+                   data[i + 2] == 0 && data[i + 3] == 1) {
+            start = i + 4;
+        } else {
+            continue;
+        }
+        if (start >= len) continue;
+        type = codec == SOURCE_CLOCK_VIDEO_H265 ? ((data[start] >> 1) & 0x3f) : (data[start] & 0x1f);
+        if ((codec == SOURCE_CLOCK_VIDEO_H264 && type == 5) ||
+            (codec == SOURCE_CLOCK_VIDEO_H265 && (type == 19 || type == 20 || type == 21))) {
+            flags |= SOURCE_CLOCK_FLAG_KEYFRAME;
+        }
+        if ((codec == SOURCE_CLOCK_VIDEO_H264 && (type == 7 || type == 8)) ||
+            (codec == SOURCE_CLOCK_VIDEO_H265 && (type == 32 || type == 33 || type == 34))) {
+            flags |= SOURCE_CLOCK_FLAG_CONFIG;
+        }
+    }
+    return flags;
+}
+
+bool source_clock_renderer_push_video(source_clock_renderer_t *renderer,
+                                      const unsigned char *data, size_t data_len,
+                                      uint64_t remote_ntp_ns, unsigned flags) {
+    uint8_t codec;
+    if (renderer == NULL || data == NULL || data_len == 0 ||
+        data_len > SOURCE_CLOCK_MAX_VIDEO_PAYLOAD) return false;
+    codec = renderer->video_codec;
+    flags |= scan_video_flags(data, data_len, codec);
+    return queue_frame(&renderer->video, data, data_len, remote_ntp_ns, codec,
+                       (uint16_t)flags, 0, 0, 0, 0);
+}
+
+bool source_clock_renderer_push_audio(source_clock_renderer_t *renderer,
+                                      const unsigned char *data, size_t data_len,
+                                      uint64_t remote_ntp_ns, unsigned flags) {
+    uint64_t duration_ns;
+    if (renderer == NULL || data == NULL || data_len == 0 ||
+        data_len > SOURCE_CLOCK_MAX_AUDIO_PAYLOAD || renderer->audio_sample_rate == 0) return false;
+    duration_ns = ((uint64_t)renderer->audio_spf * 1000000000ULL) /
+                  renderer->audio_sample_rate;
+    return queue_frame(&renderer->audio, data, data_len, remote_ntp_ns,
+                       renderer->audio_codec, (uint16_t)flags,
+                       renderer->audio_spf, renderer->audio_sample_rate,
+                       renderer->audio_channels, duration_ns);
+}
+
+size_t source_clock_renderer_video_pending(const source_clock_renderer_t *renderer) {
+    size_t result = 0;
+    if (renderer == NULL) return 0;
+    pthread_mutex_lock((pthread_mutex_t *)&renderer->video.mutex);
+    result = renderer->video.pending_count;
+    pthread_mutex_unlock((pthread_mutex_t *)&renderer->video.mutex);
+    return result;
+}
+
+size_t source_clock_renderer_audio_pending(const source_clock_renderer_t *renderer) {
+    size_t result = 0;
+    if (renderer == NULL) return 0;
+    pthread_mutex_lock((pthread_mutex_t *)&renderer->audio.mutex);
+    result = renderer->audio.pending_count;
+    pthread_mutex_unlock((pthread_mutex_t *)&renderer->audio.mutex);
+    return result;
+}
+
+uint64_t source_clock_renderer_video_dropped(const source_clock_renderer_t *renderer) {
+    uint64_t result = 0;
+    if (renderer == NULL) return 0;
+    pthread_mutex_lock((pthread_mutex_t *)&renderer->video.mutex);
+    result = renderer->video.dropped;
+    pthread_mutex_unlock((pthread_mutex_t *)&renderer->video.mutex);
+    return result;
+}
+
+uint64_t source_clock_renderer_audio_dropped(const source_clock_renderer_t *renderer) {
+    uint64_t result = 0;
+    if (renderer == NULL) return 0;
+    pthread_mutex_lock((pthread_mutex_t *)&renderer->audio.mutex);
+    result = renderer->audio.dropped;
+    pthread_mutex_unlock((pthread_mutex_t *)&renderer->audio.mutex);
+    return result;
+}
