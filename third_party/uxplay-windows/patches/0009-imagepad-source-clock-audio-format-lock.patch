diff --git a/renderers/source_clock_audio_format_lock_test.c b/renderers/source_clock_audio_format_lock_test.c
new file mode 100644
index 0000000..7bc64b1
--- /dev/null
+++ b/renderers/source_clock_audio_format_lock_test.c
@@ -0,0 +1,140 @@
+#include "source_clock_renderer.h"
+
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <windows.h>
+#else
+#include <sched.h>
+#endif
+
+typedef struct format_test_state_s {
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    unsigned ready;
+    unsigned running;
+    unsigned writes;
+    int start;
+} format_test_state_t;
+
+typedef struct format_writer_s {
+    source_clock_renderer_t *renderer;
+    format_test_state_t *state;
+    unsigned char ct;
+    unsigned short spf;
+    uint32_t sample_rate;
+    uint16_t channels;
+} format_writer_t;
+
+static void *write_format(void *argument) {
+    format_writer_t *writer = (format_writer_t *)argument;
+    unsigned i;
+    pthread_mutex_lock(&writer->state->mutex);
+    writer->state->ready++;
+    writer->state->running++;
+    pthread_cond_broadcast(&writer->state->cond);
+    while (!writer->state->start)
+        pthread_cond_wait(&writer->state->cond, &writer->state->mutex);
+    pthread_mutex_unlock(&writer->state->mutex);
+    for (i = 0; i < 200000; ++i) {
+        source_clock_renderer_set_audio_format(writer->renderer, writer->ct,
+                                               writer->spf, writer->sample_rate,
+                                               writer->channels);
+        pthread_mutex_lock(&writer->state->mutex);
+        writer->state->writes++;
+        pthread_mutex_unlock(&writer->state->mutex);
+        if ((i & 63u) == 0) {
+#ifdef _WIN32
+            Sleep(0);
+#else
+            sched_yield();
+#endif
+        }
+    }
+    pthread_mutex_lock(&writer->state->mutex);
+    writer->state->running--;
+    pthread_cond_broadcast(&writer->state->cond);
+    pthread_mutex_unlock(&writer->state->mutex);
+    return NULL;
+}
+
+static int is_tuple_a(const source_clock_audio_format_t *format) {
+    return format->codec == SOURCE_CLOCK_AUDIO_ALAC &&
+           format->samples_per_frame == 352 &&
+           format->sample_rate == 44100 &&
+           format->channels == 2;
+}
+
+static int is_tuple_b(const source_clock_audio_format_t *format) {
+    return format->codec == SOURCE_CLOCK_AUDIO_AAC_ELD &&
+           format->samples_per_frame == 480 &&
+           format->sample_rate == 48000 &&
+           format->channels == 1;
+}
+
+int main(void) {
+    const char *token = "00112233445566778899aabbccddeeff";
+    source_clock_renderer_t *renderer;
+    format_test_state_t state = { 0 };
+    format_writer_t writer_a;
+    format_writer_t writer_b;
+    pthread_t thread_a;
+    pthread_t thread_b;
+    unsigned i;
+    unsigned previous_writes = 0;
+    unsigned write_advances = 0;
+    unsigned overlap_reads = 0;
+#ifdef _WIN32
+    WSADATA wsa;
+    assert(WSAStartup(MAKEWORD(2, 2), &wsa) == 0);
+#endif
+    renderer = source_clock_renderer_create("127.0.0.1:1", "127.0.0.1:1", token);
+    assert(renderer != NULL);
+    assert(pthread_mutex_init(&state.mutex, NULL) == 0);
+    assert(pthread_cond_init(&state.cond, NULL) == 0);
+    source_clock_renderer_set_audio_format(renderer, 2, 352, 44100, 2);
+    writer_a = (format_writer_t){ renderer, &state, 2, 352, 44100, 2 };
+    writer_b = (format_writer_t){ renderer, &state, 8, 480, 48000, 1 };
+    assert(pthread_create(&thread_a, NULL, write_format, &writer_a) == 0);
+    assert(pthread_create(&thread_b, NULL, write_format, &writer_b) == 0);
+    pthread_mutex_lock(&state.mutex);
+    while (state.ready != 2)
+        pthread_cond_wait(&state.cond, &state.mutex);
+    state.start = 1;
+    pthread_cond_broadcast(&state.cond);
+    pthread_mutex_unlock(&state.mutex);
+    for (i = 0; i < 800000; ++i) {
+        source_clock_audio_format_t format;
+        unsigned writes;
+        unsigned running;
+        assert(source_clock_renderer_get_audio_format(renderer, &format));
+        assert(is_tuple_a(&format) || is_tuple_b(&format));
+        pthread_mutex_lock(&state.mutex);
+        writes = state.writes;
+        running = state.running;
+        pthread_mutex_unlock(&state.mutex);
+        if (running > 0) overlap_reads++;
+        if (writes > previous_writes) write_advances++;
+        previous_writes = writes;
+        if (running == 0) break;
+    }
+    pthread_join(thread_a, NULL);
+    pthread_join(thread_b, NULL);
+    assert(state.writes == 400000);
+    assert(overlap_reads > 1000);
+    assert(write_advances > 100);
+    pthread_cond_destroy(&state.cond);
+    pthread_mutex_destroy(&state.mutex);
+    source_clock_renderer_destroy(renderer);
+#ifdef _WIN32
+    WSACleanup();
+#endif
+    puts("source_clock_audio_format_lock: PASS");
+    return 0;
+}
